+def epreuve_10_courbure(journal, dossier):
+    """LA FIXTURE DE LA SEPTIEME OCCURRENCE, demandee par l'agent plancher.
+
+    Une galerie COURBE dont le PLANCHER MONTE. Il faut les deux :
+
+      * la courbure ecarte la normale de X, donc un echantillonnage le long
+        de X sort de la cavite ou change de station ;
+      * le plancher qui monte transforme cette erreur de placement en erreur
+        de HAUTEUR mesurable. Sur un plancher plat, viser a cote ne se voit
+        pas — et c'est pour cela que la faute a survecu six corrections.
+
+    Sur cette geometrie l'ancien echantillonnage doit rougir, le nouveau
+    passer, et la roche est saine dans les deux cas : le rouge est
+    entierement produit par l'instrument.
+    """
+    journal.epreuve("10", "COURBURE + PLANCHER MONTANT — fixture de la 7e "
+                          "occurrence")
+    stations = stations_coudees()
+    profil = profil_de(stations, "coude")
+    chemin = os.path.join(dossier, "coude.glb")
+    ecrire_glb(chemin, tunnel(stations))
+    tris, _ = P.triangles_du_glb(chemin)
+    grille = P.Grille(tris)
+
+    # Ce que la normale vaut vraiment : sans ecart a X, la fixture ne
+    # prouverait rien, et il faut le MESURER plutot que l'affirmer.
+    ecarts = []
+    for i in range(len(stations)):
+        nx, ny = profil.normale(float(i))
+        ecarts.append(math.degrees(math.atan2(abs(ny), abs(nx))))
+    journal.dire("   ecart de la normale a l'axe X : %.1f a %.1f degres"
+                 % (min(ecarts), max(ecarts)))
+    journal.dire("   le plancher monte de %.2f m a %.2f m"
+                 % (-stations[0][4], -stations[-1][4]))
+
+    def _fautes(le_long_de_x):
+        """Carte du plancher, ancien ou nouveau placement."""
+        fautes = 0
+        lignes = 0
+        u = 0.0
+        while u <= len(profil.cavite) - 1 + 1e-9:
+            ax, ay, hw, cle, palier = profil.station(u)
+            nx, ny = profil.normale(u)
+            for f in (-0.60, -0.30, 0.0, 0.30, 0.60):
+                if le_long_de_x:
+                    # ANCIEN : le long de X, demi-largeur SYMETRIQUE.
+                    px, py = ax + f * hw, ay
+                    sol = profil.sol(u, f)
+                else:
+                    # NOUVEAU : le long de la NORMALE, largeur du COTE, et
+                    # sol lu a la station REELLE du point.
+                    lat = f * profil.demi_largeur(u, f)
+                    px, py = ax + lat * nx, ay + lat * ny
+                    u_reel = P.station_reelle_du_point(profil, (px, py, 0.0))
+                    sol = profil.sol(u_reel, f)
+                depart = (px, py, sol + 0.90)
+                vide, _ = P.dans_le_vide(grille, depart)
+                if not vide:
+                    continue
+                lignes += 1
+                liste = P.impacts(grille, depart, (0.0, 0.0, -1.0))
+                if not liste or liste[0][0] - 0.90 > P.PLANCHER_TOLERANCE_M:
+                    fautes += 1
+            u += 0.5
+        return fautes, lignes
+
+    f_ancien, n_ancien = _fautes(True)
+    f_nouveau, n_nouveau = _fautes(False)
+    journal.dire("   ANCIEN echantillonnage (le long de X, largeur "
+                 "symetrique) : %d faute(s) sur %d point(s) sondes"
+                 % (f_ancien, n_ancien))
+    journal.dire("   NOUVEAU echantillonnage (normale, largeur du cote, sol "
+                 "a la station reelle) : %d faute(s) sur %d"
+                 % (f_nouveau, n_nouveau))
+    journal.dire("   la roche est la MEME dans les deux cas : le rouge est "
+                 "produit par l'instrument, pas par la geometrie.")
+    journal.archiver("epreuve10_courbure.json",
+                     json.dumps(dict(ecart_normale_deg=[min(ecarts),
+                                                        max(ecarts)],
+                                     ancien=dict(fautes=f_ancien,
+                                                 points=n_ancien),
+                                     nouveau=dict(fautes=f_nouveau,
+                                                  points=n_nouveau)),
+                                indent=1))
+    return journal.rouge_puis_vert(
+        f_ancien > 0, f_nouveau == 0,
+        "le long de X : %d faute(s) sur une roche saine" % f_ancien,
+        "le long de la normale : %d faute(s) sur %d point(s)"
+        % (f_nouveau, n_nouveau))
+
+
