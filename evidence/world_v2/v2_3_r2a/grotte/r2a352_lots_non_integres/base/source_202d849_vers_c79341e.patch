+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""EXPORTS D'ÉTAPE de la chaîne de la grotte — instrumentation, pas géométrie.
+
+POURQUOI CE SCRIPT EXISTE
+=========================
+
+Les 19 ouvertures franches du toit de `A1_ASYM` traversent ZÉRO roche dans
+le `.glb` livré, alors que le modèle analytique de l'agent A annonce 0,88 à
+3,10 m de roche aux mêmes endroits. L'écart naît donc APRÈS le modèle. Le
+journal de la chaîne éteint deux des trois pistes :
+
+    [grotte] remaillage : 1 coque exterieure, 0 bulle, 0 ecaille retirees
+
+Ni bulle ni écaille retirées. Reste la décimation — 137 088 → 19 000 tris,
+appliquée AVANT que la cavité ne soit creusée — et la soustraction booléenne
+elle-même.
+
+CE QU'IL FAIT, ET CE QU'IL NE TOUCHE PAS
+========================================
+
+Il n'écrit pas une ligne dans le générateur de l'agent A. Il le CHARGE comme
+un module (donc sans déclencher `main()`, qui ne part que sous
+`__name__ == "__main__"`), enveloppe trois fonctions pour exporter le
+maillage juste après leur passage, puis appelle `main()`. La séquence
+exécutée est donc exactement la sienne : aucune cote, aucun seuil, aucun
+paramètre de décimation n'est modifié, et aucun risque de diverger en
+recopiant sa main() à la main.
+
+TROIS ÉTAPES, PAS DEUX. La demande portait sur « après remaillage » et
+« après décimation ». Mais `stratifier()` passe ENTRE les deux et déplace
+lui aussi la surface. Avec deux exports seulement, une disparition de roche
+resterait partagée entre stratification et décimation. Le troisième export
+sépare les deux, pour le prix d'un fichier.
+
+Sortie : `etape_remaille.glb`, `etape_stratifie.glb`, `etape_decime.glb`,
+tous AVANT soustraction.
+
+Usage (Blender, sous verrou d'outil lourd) :
+    blender --background --python-exit-code 1 \\
+        --python tools/blender/diag_cave_etapes.py -- --diagnostic
+"""
+
+import os
+import sys
+import types
+
+import bpy
+
+## Le générateur SUJET. Lu, jamais écrit.
+SOURCE = ("/home/user/zelda-r2a351/a_profil/source_assets/blender/"
+          "environment/make_waterfall_cave.py")
+
+## Les exports vont dans MON arbre.
+SORTIE = ("/home/user/zelda-r2a351/b_sonde/evidence/R2a-3.5.1/b_sonde/"
+          "etapes")
+
+## `main()` sauve un `.blend` à côté de `__file__`. On lui donne donc un
+## `__file__` DANS MON ARBRE : sans cela l'exécution écrirait dans le
+## worktree de l'agent A, qui est en lecture seule pour moi.
+FICHIER_FEINT = ("/home/user/zelda-r2a351/b_sonde/source_assets/blender/"
+                 "environment/make_waterfall_cave.py")
+
+ETAPES = (("remailler_voxel", "remaille"),
+          ("stratifier", "stratifie"),
+          ("decimer", "decime"))
+
+
+def _exporter(obj, etiquette):
+    if obj is None or not hasattr(obj, "select_set"):
+        print("[diag] %s : pas d'objet a exporter" % etiquette)
+        return
+    if not os.path.isdir(SORTIE):
+        os.makedirs(SORTIE)
+    chemin = os.path.join(SORTIE, "etape_%s.glb" % etiquette)
+    bpy.ops.object.select_all(action="DESELECT")
+    obj.select_set(True)
+    bpy.context.view_layer.objects.active = obj
+    voulu = dict(filepath=chemin, export_format="GLB", use_selection=True)
+    connues = set(bpy.ops.export_scene.gltf.get_rna_type().properties.keys())
+    options = dict((k, v) for k, v in voulu.items()
+                   if k == "filepath" or k in connues)
+    bpy.ops.export_scene.gltf(**options)
+    tris = sum(len(p.vertices) - 2 for p in obj.data.polygons)
+    octets = os.path.getsize(chemin) if os.path.isfile(chemin) else -1
+    print("[diag] etape %-10s -> %s  (%d tris, %d octets)"
+          % (etiquette, chemin, tris, octets))
+
+
+def main():
+    if not os.path.isfile(SOURCE):
+        print("[diag] BLOQUE: generateur introuvable : %s" % SOURCE)
+        return 3
+    source = open(SOURCE, "r", encoding="utf-8").read()
+
+    module = types.ModuleType("gen_cave_sujet")
+    module.__file__ = FICHIER_FEINT
+    sys.modules["gen_cave_sujet"] = module
+    # `__name__` vaut "gen_cave_sujet", donc le `if __name__ == "__main__"`
+    # du generateur ne se declenche pas : on choisit quand main() part.
+    exec(compile(source, SOURCE, "exec"), module.__dict__)
+
+    manquantes = [n for n, _ in ETAPES if not hasattr(module, n)]
+    if manquantes:
+        print("[diag] BLOQUE: fonctions absentes du generateur : %s"
+              % ", ".join(manquantes))
+        return 3
+
+    for nom, etiquette in ETAPES:
+        original = getattr(module, nom)
+
+        def enveloppe(*args, _o=original, _e=etiquette, **kwargs):
+            resultat = _o(*args, **kwargs)
+            # `decimer` rend l'objet ; les autres rendent None. On prend
+            # l'objet rendu s'il y en a un, sinon le premier argument.
+            cible = resultat if hasattr(resultat, "select_set") else (
+                args[0] if args else None)
+            _exporter(cible, _e)
+            return resultat
+
+        setattr(module, nom, enveloppe)
+        print("[diag] enveloppe posee sur %s() -> etape_%s.glb"
+              % (nom, etiquette))
+
+    print("[diag] lancement de main() du generateur SUJET")
+    code = module.main()
+    print("[diag] main() du sujet rend %s" % code)
+    produits = sorted(f for f in os.listdir(SORTIE)) if os.path.isdir(SORTIE) \
+        else []
+    print("[diag] fichiers d'etape : %s" % (", ".join(produits) or "AUCUN"))
+    # Le code de la chaine n'est PAS le verdict de ce script : on mesure des
+    # etapes, on ne livre rien. Mais l'absence d'export est un blocage.
+    if len(produits) < len(ETAPES):
+        print("[diag] BLOQUE: %d export(s) sur %d" % (len(produits),
+                                                      len(ETAPES)))
+        return 3
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
