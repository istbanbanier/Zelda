+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""CONTRÔLE NÉGATIF de la carte d'épaisseur — un défaut dont on sait tout.
+
+POURQUOI CET OUTIL EXISTE
+=========================
+
+`tools/plot_cave_section.py` produit une carte d'épaisseur par station, par
+côté et par azimut. Une carte est une image : elle a l'air juste. Rien dans
+une jolie image ne prouve qu'elle désigne le bon côté, la bonne station, ni
+qu'elle mesure une épaisseur plutôt qu'autre chose.
+
+C'est exactement la faute qui a coûté la passe R2a-3.5.1. Une sonde de
+contenance annonçait « +1,36 m au linteau, +5,39 m au coude, 9/9 stations ».
+Le chiffre était vrai — et il ne mesurait que le TOIT. Pendant ce temps la
+galerie traversait la roche sur 0,11 m d'épaisseur sur tout un flanc. Une
+mesure qui répond à une autre question que celle posée est pire qu'une
+absence de mesure, parce qu'elle rassure.
+
+CE QUE CET OUTIL PROUVE, ET COMMENT
+===================================
+
+Il fabrique des tunnels dont l'épaisseur de chaque paroi est CHOISIE, écrit
+un `.glb`, puis soumet ce `.glb` à la MÊME chaîne de mesure que la grotte
+réelle. La réponse est connue avant la mesure ; l'écart entre la réponse
+connue et la mesure est le seul verdict qui compte.
+
+Quatre épreuves, et la deuxième est la seule qui interdit vraiment l'erreur
+de signe :
+
+  1. PAROI FINE À DROITE  — gauche épaisse, droite mince. La carte doit
+     nommer `droite`, et rendre la valeur posée.
+  2. PAROI FINE À GAUCHE  — les deux épaisseurs ÉCHANGÉES. Le verdict doit
+     s'échanger aussi. Sans cette épreuve, une convention de côté inversée
+     passerait l'épreuve 1 par chance une fois sur deux : il suffirait que
+     le défaut soit systématiquement du même côté pour ne jamais le voir.
+  3. TROU À UNE STATION CONNUE — une percée franche sur un côté et une
+     station choisis. La carte doit la classer `TROU`, du bon côté, à la
+     bonne station — pas la fondre dans une épaisseur de 0,00 m.
+  4. CAROTTAGE DU MAILLAGE RÉEL — les trois premières tournent sur une
+     boîte. Celle-ci ampute le GLB livré le long d'un rayon connu et exige
+     que le bon flanc soit désigné, l'autre restant intact.
+
+CE QUE CE CONTRÔLE NE PROUVE PAS
+================================
+
+Que la carte soit juste ne rend pas la grotte étanche, et l'inverse est
+vrai aussi : ces épreuves peuvent toutes passer sur une géométrie percée.
+Elles établissent que l'INSTRUMENT désigne le bon côté et la bonne station,
+rien de plus. Le verdict d'étanchéité appartient à `probe_cave_openings.py`.
+
+ÉPROUVÉ CONTRE SA PROPRE INVERSION. Une convention de côté délibérément
+inversée fait tomber 13 des 15 vérifications. Les deux survivantes sont
+instructives : l'épreuve d'échange (2) compare les cas entre eux et reste
+donc aveugle à une inversion GLOBALE — seules les vérifications absolues
+« le côté X mesure l'épaisseur posée » l'attrapent. Il faut les deux.
+
+Codes de sortie : 0 = toutes les épreuves passent · 1 = au moins une
+échoue · 3 = BLOQUÉ (dépendance absente). Jamais 0 sur une épreuve sautée.
+"""
+
+import argparse
+import math
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import probe_cave_openings as sonde                      # noqa: E402
+import probe_cave_selftest as epreuve                    # noqa: E402
+import plot_cave_section as carte                        # noqa: E402
+
+
+## Le tunnel de contrôle. Droit, sans palier ni cuvette : toute asymétrie
+## mesurée vient donc de l'épaisseur posée, jamais du profil.
+Y_BOUCHE, Y_FOND = -1.15, 9.25
+DEMI_LARGEUR, CLE = 1.50, 2.50
+
+## Épaisseur verticale, franchement au-dessus des deux épaisseurs latérales
+## éprouvées : le minimum d'un côté doit être porté par la PAROI, pas par le
+## toit ni par le sol. Si le toit était le plus mince, l'épreuve mesurerait
+## le toit en croyant mesurer la paroi — la faute même qu'elle traque.
+EPAISSEUR_VERTICALE = 1.60
+
+## Tolérance sur l'épaisseur mesurée. Le rayon d'azimut 0 traverse la paroi
+## perpendiculairement, la lecture doit donc tomber sur la valeur posée à la
+## précision du maillage près.
+TOLERANCE_M = 0.02
+
+
+def tunnel_asymetrique(epaisseur_gauche, epaisseur_droite, trou=None):
+    """Coque fermée d'un tunnel rectangulaire à parois INÉGALES.
+
+    Repose sur `_quad` de l'épreuve, donc sur le même écrivain de GLB que
+    la sonde éprouve déjà. Convention reprise du générateur et de
+    `Profil.normale()` : la normale de section vaut ici (+1, 0), donc le
+    côté `droite` est la face +x et le côté `gauche` la face -x.
+    """
+    hx, hy = DEMI_LARGEUR, CLE
+    xd, xg = hx + epaisseur_droite, -(hx + epaisseur_gauche)
+    oz0, oz1 = -EPAISSEUR_VERTICALE, hy + EPAISSEUR_VERTICALE
+    oy = Y_FOND + max(epaisseur_gauche, epaisseur_droite)
+    t = trou
+    tris = []
+    # --- surfaces EXTÉRIEURES, normale vers le dehors ---------------------
+    tris += epreuve._quad([(xd, Y_BOUCHE, oz0), (xd, oy, oz0), (xd, oy, oz1),
+                           (xd, Y_BOUCHE, oz1)], t)
+    tris += epreuve._quad([(xg, Y_BOUCHE, oz0), (xg, Y_BOUCHE, oz1),
+                           (xg, oy, oz1), (xg, oy, oz0)], t)
+    tris += epreuve._quad([(xg, oy, oz0), (xg, oy, oz1), (xd, oy, oz1),
+                           (xd, oy, oz0)], t)
+    tris += epreuve._quad([(xg, Y_BOUCHE, oz1), (xd, Y_BOUCHE, oz1),
+                           (xd, oy, oz1), (xg, oy, oz1)], t)
+    tris += epreuve._quad([(xg, Y_BOUCHE, oz0), (xg, oy, oz0), (xd, oy, oz0),
+                           (xd, Y_BOUCHE, oz0)], t)
+    # --- l'anneau de la bouche ------------------------------------------
+    for bande in ((xg, -hx, oz0, oz1), (hx, xd, oz0, oz1),
+                  (-hx, hx, oz0, 0.0), (-hx, hx, hy, oz1)):
+        x0, x1, z0, z1 = bande
+        tris += epreuve._quad([(x0, Y_BOUCHE, z0), (x1, Y_BOUCHE, z0),
+                               (x1, Y_BOUCHE, z1), (x0, Y_BOUCHE, z1)])
+    # --- surfaces INTÉRIEURES, normale vers la galerie --------------------
+    tris += epreuve._quad([(hx, Y_BOUCHE, 0.0), (hx, Y_BOUCHE, hy),
+                           (hx, Y_FOND, hy), (hx, Y_FOND, 0.0)], t)
+    tris += epreuve._quad([(-hx, Y_BOUCHE, 0.0), (-hx, Y_FOND, 0.0),
+                           (-hx, Y_FOND, hy), (-hx, Y_BOUCHE, hy)], t)
+    tris += epreuve._quad([(-hx, Y_FOND, 0.0), (hx, Y_FOND, 0.0),
+                           (hx, Y_FOND, hy), (-hx, Y_FOND, hy)], t)
+    tris += epreuve._quad([(-hx, Y_BOUCHE, hy), (-hx, Y_FOND, hy),
+                           (hx, Y_FOND, hy), (hx, Y_BOUCHE, hy)], t)
+    tris += epreuve._quad([(-hx, Y_BOUCHE, 0.0), (hx, Y_BOUCHE, 0.0),
+                           (hx, Y_FOND, 0.0), (-hx, Y_FOND, 0.0)], t)
+    return tris
+
+
+def profil_du_tunnel():
+    """Profil analytique du tunnel de contrôle.
+
+    `cavite_asym` reste plat à 1,0 : le tunnel est droit et symétrique EN
+    NOMINAL. Toute asymétrie mesurée vient donc de la roche posée autour,
+    ce qui est précisément ce qu'on veut éprouver.
+    """
+    return sonde.Profil(
+        cavite=[(0.0, Y_BOUCHE + (Y_FOND - Y_BOUCHE) * i / 8.0,
+                 DEMI_LARGEUR, CLE) for i in range(9)],
+        palier=tuple([0.0] * 9), sag=0.0, porche_denivele=0.0, asym=1.0,
+        nom="controle_negatif")
+
+
+def mesurer(chemin, profil, seuil_paroi, seuil_collerette, pas_station=0.5):
+    """Passe le GLB par la MÊME chaîne que la grotte réelle."""
+    tris, _ = sonde.triangles_du_glb(chemin, "SM_WaterfallCave")
+    grille = sonde.Grille(tris)
+    lignes = carte.mesurer_epaisseurs(grille, profil, pas_station, 10)
+    journal = carte.journal_des_minima(lignes, seuil_paroi, seuil_collerette)
+    return lignes, journal
+
+
+def minimum_de_galerie(journal, cote):
+    """Minimum du côté, GALERIE seule, et la station qui le porte."""
+    entrees = [e for e in journal if e["cote"] == cote
+               and e["zone"] == "galerie" and e["metres"] is not None]
+    if not entrees:
+        return None, None
+    pire = min(entrees, key=lambda e: e["metres"])
+    return pire["metres"], pire["u"]
+
+
+def stations_trouees(journal, cote):
+    return [e["u"] for e in journal if e["cote"] == cote
+            and e["zone"] == "galerie" and e["verdict"] == "TROU"]
+
+
+class Journal(object):
+    def __init__(self):
+        self.echecs = 0
+        self.lignes = []
+
+    def verifier(self, condition, titre, detail=""):
+        etat = "PASS" if condition else "FAIL"
+        if not condition:
+            self.echecs += 1
+        self.lignes.append((etat, titre))
+        print("   [%s] %-58s %s" % (etat, titre, detail))
+
+
+def epreuve_paroi_fine(journal, dossier, seuils, gauche_m, droite_m,
+                       etiquette):
+    """Une paroi mince d'un côté CHOISI : la carte doit nommer ce côté."""
+    seuil_paroi, seuil_collerette = seuils
+    print()
+    print("-" * 74)
+    print("EPREUVE — %s (gauche %.2f m, droite %.2f m, seuil %.2f m)"
+          % (etiquette, gauche_m, droite_m, seuil_paroi))
+    print("-" * 74)
+    chemin = os.path.join(dossier, "controle_%s.glb" % etiquette)
+    epreuve.ecrire_glb(chemin, tunnel_asymetrique(gauche_m, droite_m))
+    profil = profil_du_tunnel()
+    _, jrn = mesurer(chemin, profil, seuil_paroi, seuil_collerette)
+
+    mesure_g, u_g = minimum_de_galerie(jrn, "gauche")
+    mesure_d, u_d = minimum_de_galerie(jrn, "droite")
+    print("   mesure : gauche %s   droite %s"
+          % ("n/a" if mesure_g is None
+             else "%.3f m (u=%.2f)" % (mesure_g, u_g),
+             "n/a" if mesure_d is None
+             else "%.3f m (u=%.2f)" % (mesure_d, u_d)))
+
+    for cote, pose, mesure in (("gauche", gauche_m, mesure_g),
+                               ("droite", droite_m, mesure_d)):
+        journal.verifier(
+            mesure is not None and abs(mesure - pose) <= TOLERANCE_M,
+            "%s : le cote %s mesure l'epaisseur POSEE" % (etiquette, cote),
+            "pose %.3f m, mesure %s, tolerance %.2f m"
+            % (pose, "n/a" if mesure is None else "%.3f m" % mesure,
+               TOLERANCE_M))
+
+    # LE CÔTÉ MINCE EST-IL CELUI QU'ON A AMINCI ? C'est la question que la
+    # passe précédente n'a jamais posée.
+    mince_pose = "gauche" if gauche_m < droite_m else "droite"
+    mince_mesure = None
+    if mesure_g is not None and mesure_d is not None:
+        mince_mesure = "gauche" if mesure_g < mesure_d else "droite"
+    journal.verifier(
+        mince_mesure == mince_pose,
+        "%s : le cote DESIGNE est celui qui est mince" % etiquette,
+        "aminci = %s, designe = %s" % (mince_pose, mince_mesure))
+
+    # Et le verdict contractuel doit tomber du bon côté du seuil.
+    for cote, pose, mesure in (("gauche", gauche_m, mesure_g),
+                               ("droite", droite_m, mesure_d)):
+        attendu = "PASS" if pose >= seuil_paroi else "FAIL"
+        obtenu = None
+        if mesure is not None:
+            obtenu = "PASS" if mesure >= seuil_paroi else "FAIL"
+        journal.verifier(
+            obtenu == attendu,
+            "%s : verdict %s attendu %s" % (etiquette, cote, attendu),
+            "mesure %s / seuil %.2f m -> %s"
+            % ("n/a" if mesure is None else "%.3f m" % mesure, seuil_paroi,
+               obtenu))
+    return mesure_g, mesure_d
+
+
+def epreuve_trou_localise(journal, dossier, seuils):
+    """Une percée franche, d'un côté et à une station connus."""
+    seuil_paroi, seuil_collerette = seuils
+    # Le trou perce la paroi GAUCHE, autour de y = 4,0 -> station u ~ 3,96.
+    y0, y1 = 3.6, 4.4
+    boite = ((-(DEMI_LARGEUR + 2.0), y0, 0.8),
+             (-(DEMI_LARGEUR - 0.2), y1, 1.8))
+    profil = profil_du_tunnel()
+    u_attendu = profil.u_pour_y(0.5 * (y0 + y1))
+    print()
+    print("-" * 74)
+    print("EPREUVE — TROU LOCALISE (cote gauche, y in [%.1f ; %.1f], "
+          "u attendu ~ %.2f)" % (y0, y1, u_attendu))
+    print("-" * 74)
+    chemin = os.path.join(dossier, "controle_trou.glb")
+    epreuve.ecrire_glb(chemin, tunnel_asymetrique(1.20, 1.20, trou=boite))
+    _, jrn = mesurer(chemin, profil, seuil_paroi, seuil_collerette)
+
+    troues_g = stations_trouees(jrn, "gauche")
+    troues_d = stations_trouees(jrn, "droite")
+    print("   stations TROUEES : gauche %s   droite %s"
+          % (troues_g or "aucune", troues_d or "aucune"))
+
+    journal.verifier(bool(troues_g),
+                     "trou : le cote GAUCHE est signale troue",
+                     "stations %s" % (troues_g or "aucune"))
+    journal.verifier(not troues_d,
+                     "trou : le cote DROITE reste intact",
+                     "stations %s" % (troues_d or "aucune"))
+    proches = [u for u in troues_g if abs(u - u_attendu) <= 0.75]
+    journal.verifier(
+        bool(proches),
+        "trou : signale a la BONNE station (+/- 0,75)",
+        "attendu ~ %.2f, obtenu %s" % (u_attendu, troues_g or "aucune"))
+
+    # ET SURTOUT : un trou ne doit pas être publié comme « 0,00 m
+    # d'epaisseur ». C'est la confusion que la carte doit rendre impossible.
+    fondu = [e for e in jrn if e["cote"] == "gauche" and e["zone"] == "galerie"
+             and e["metres"] is not None and e["metres"] <= 0.001]
+    journal.verifier(
+        not fondu,
+        "trou : aucune percee n'est publiee comme une epaisseur de 0,00 m",
+        "%d entree(s) fondue(s)" % len(fondu))
+
+
+def epreuve_carottage_reel(journal, seuils, glb, u_cible=6.0,
+                           cote_cible="gauche", rayon_carotte=0.9):
+    """Carottage d'un flanc CHOISI sur la GÉOMÉTRIE RÉELLE.
+
+    Les trois premières épreuves tournent sur un tunnel synthétique : la
+    réponse y est connue, mais la géométrie est une boîte. Celle-ci ampute
+    le maillage LIVRÉ le long d'un rayon dont on connaît le côté et la
+    station, et exige que la carte le désigne — et surtout que le côté
+    OPPOSÉ reste intact.
+
+    DEUX TENTATIVES ONT ÉCHOUÉ AVANT CELLE-CI, et c'est instructif :
+
+      * retirer les triangles « du côté gauche, près de la station » n'a
+        rien changé — les grandes faces de la coque extérieure enjambent la
+        fenêtre en y, donc aucune n'avait ses trois sommets dedans. La
+        mutation ne touchait pas la roche que le rayon traverse ;
+      * retirer la seule face de SORTIE n'a rien changé non plus, et c'est
+        correct : l'épaisseur publiée est celle du PREMIER bloc, qui restait
+        entier.
+
+    Une mutation qu'on n'a pas vérifiée est une preuve qu'on n'a pas faite.
+    On retire donc la matière autour de TOUS les impacts du rayon visé.
+    """
+    seuil_paroi, seuil_collerette = seuils
+    print()
+    print("-" * 74)
+    print("EPREUVE — CAROTTAGE DU MAILLAGE REEL (cote %s, station u = %.1f)"
+          % (cote_cible, u_cible))
+    print("-" * 74)
+    if not os.path.isfile(glb):
+        journal.verifier(False, "maillage de production lisible", glb)
+        return
+    tris, _ = sonde.triangles_du_glb(glb, "SM_WaterfallCave")
+    profil = sonde.PROFIL_GROTTE
+
+    def trouees(triangles):
+        grille = sonde.Grille(triangles)
+        jrn = carte.journal_des_minima(
+            carte.mesurer_epaisseurs(grille, profil, 0.5, 10),
+            seuil_paroi, seuil_collerette)
+        return {c: set(e["u"] for e in jrn if e["cote"] == c
+                       and e["zone"] == "galerie" and e["verdict"] == "TROU")
+                for c in carte.COTES_PAROI}
+
+    avant = trouees(tris)
+    ax, ay, _, cle, palier = profil.station(u_cible)
+    sol = profil.sol(u_cible, 0.0)
+    origine = (ax, ay, sol + 0.5 * (palier + cle - sol))
+    tx, ty = carte._direction_transverse(profil, u_cible)
+    signe = -1.0 if cote_cible == carte.COTE_GAUCHE else 1.0
+    direction = (signe * tx, signe * ty, 0.0)
+    ts = [t for t, _ in sonde.impacts(sonde.Grille(tris), origine, direction,
+                                      portee=60.0)]
+    if not ts:
+        journal.verifier(False,
+                         "le rayon vise rencontre de la roche avant carottage",
+                         "aucun impact : rien a carotter, "
+                         "l'epreuve serait vide")
+        return
+    points = [tuple(origine[k] + direction[k] * t for k in range(3))
+              for t in ts]
+
+    def touche(tri):
+        return any(any(math.dist(s, p) <= rayon_carotte for p in points)
+                   for s in tri)
+
+    carotte = [t for t in tris if not touche(t)]
+    retires = len(tris) - len(carotte)
+    print("   impacts du rayon : %s" % [round(t, 2) for t in ts])
+    print("   triangles retires : %d sur %d" % (retires, len(tris)))
+    journal.verifier(retires > 0, "le carottage retire de la matiere",
+                     "%d triangle(s)" % retires)
+
+    apres = trouees(carotte)
+    oppose = (carte.COTE_DROITE if cote_cible == carte.COTE_GAUCHE
+              else carte.COTE_GAUCHE)
+    neufs_cible = sorted(apres[cote_cible] - avant[cote_cible])
+    neufs_oppose = sorted(apres[oppose] - avant[oppose])
+    print("   nouveaux trous : %s %s   %s %s"
+          % (cote_cible, neufs_cible or "aucun", oppose,
+             neufs_oppose or "aucun"))
+    journal.verifier(
+        bool(neufs_cible),
+        "carottage : le cote %s CAROTTE est signale" % cote_cible,
+        "stations %s" % (neufs_cible or "aucune"))
+    journal.verifier(
+        not neufs_oppose,
+        "carottage : le cote %s INTACT ne bouge pas" % oppose,
+        "stations %s" % (neufs_oppose or "aucune"))
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--glb",
+                    default="assets/environment/caves/SM_WaterfallCave.glb",
+                    help="maillage de production, pour le carottage reel")
+    ap.add_argument("--garder", default=None,
+                    help="dossier ou conserver les GLB de controle")
+    ap.add_argument("--source",
+                    default="source_assets/blender/environment/"
+                            "make_waterfall_cave.py")
+    args = ap.parse_args()
+
+    print("=" * 74)
+    print("CONTROLE NEGATIF DE LA CARTE D'EPAISSEUR")
+    print("=" * 74)
+    try:
+        seuils = carte.lire_seuils_du_generateur(args.source)
+    except carte.Blocage as erreur:
+        print("BLOQUE: %s" % erreur)
+        return 3
+    print("seuils LUS au generateur : paroi %.2f m · collerette %.2f m"
+          % seuils)
+
+    dossier = args.garder or tempfile.mkdtemp(prefix="controle_negatif_")
+    if not os.path.isdir(dossier):
+        os.makedirs(dossier)
+    journal = Journal()
+    try:
+        a_g, a_d = epreuve_paroi_fine(journal, dossier, seuils,
+                                      1.20, 0.30, "fine_a_droite")
+        b_g, b_d = epreuve_paroi_fine(journal, dossier, seuils,
+                                      0.30, 1.20, "fine_a_gauche")
+        # L'ÉCHANGE DOIT S'ENTENDRE DANS LA MESURE. Si les deux cas rendaient
+        # le même côté mince, la convention de côté serait inversée ou
+        # ignorée, et l'épreuve 1 seule ne l'aurait pas vu.
+        print()
+        journal.verifier(
+            None not in (a_g, a_d, b_g, b_d)
+            and abs(a_g - b_d) <= TOLERANCE_M
+            and abs(a_d - b_g) <= TOLERANCE_M,
+            "ECHANGER LES PAROIS ECHANGE LA MESURE",
+            "cas A (g=%s, d=%s) contre cas B (g=%s, d=%s)"
+            % tuple("n/a" if v is None else "%.3f" % v
+                    for v in (a_g, a_d, b_g, b_d)))
+        epreuve_trou_localise(journal, dossier, seuils)
+        epreuve_carottage_reel(journal, seuils, args.glb)
+    finally:
+        if not args.garder:
+            shutil.rmtree(dossier, ignore_errors=True)
+
+    print()
+    print("=" * 74)
+    total = len(journal.lignes)
+    print("EPREUVES : %d / %d passees" % (total - journal.echecs, total))
+    print("VERDICT : %s" % ("PASS" if journal.echecs == 0
+                            else "FAIL — %d epreuve(s) rouge(s)"
+                                 % journal.echecs))
+    print("=" * 74)
+    return 1 if journal.echecs else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
