+"""COLLERETTE DANS LE PLAN DE BOUCHE — EDT euclidienne EXACTE + coupe minimale.
+
+    blender --background <blend> --python-exit-code 1 \\
+        --python tools/blender/probe_cave_edt_plan_bouche.py
+
+CONTROLE de `cave_collar.py` methode B, ecrit pour verifier son chiffre sans
+partager une ligne de code avec lui. Ne modifie rien, ne juge rien, rend 0.
+
+TROIS DIFFERENCES DELIBEREES avec l'instrument qu'il verifie :
+
+  * pas de 0,04 m au lieu de 0,2 m — la quantification de raster est divisee
+    par cinq ;
+  * EDT euclidienne EXACTE (Felzenszwalb, deux passes sur les distances au
+    carre), pas un chanfrein 8-connexe. Un chanfrein {1, racine de 2}
+    surestime l'euclidien de jusqu'a 8 % selon l'angle ;
+  * l'epaisseur n'est pas le maximum d'une EDT le long d'un axe median
+    devine, c'est le GOULOT DE LA COUPE MINIMALE : la plus grande erosion
+    que la roche supporte avant que le vide de l'ouverture communique avec
+    le vide exterieur. Calcule par union-find sur les cellules de roche
+    triees par EDT croissante — donc sans choisir de chemin a la main.
+
+VERDICT DU CONTROLE, 2026-08-16 : sur la geometrie d'avant la visiere, les
+deux instruments rendent 0,5657 m. Ils concordent, et ma propre sonde a
+sphere inscrite (`probe_cave_collerette.py`), qui lisait 0,68 m, etait la
+seule optimiste — parce qu'une sphere en 3D S'ECHAPPE LE LONG DE Y, ou le
+jambage est epais. La collerette se mesure DANS LE PLAN de bouche.
+"""
+
+import bpy, math, sys
+from mathutils import Vector
+from mathutils.bvhtree import BVHTree
+
+PAS = 0.04
+Y = -1.15
+X0, X1 = -4.40, 3.60
+Z0, Z1 = -0.80, 4.40
+
+o = bpy.data.objects["SM_WaterfallCave"]
+sv=[v.co.copy() for v in o.data.vertices]; pl=[tuple(p.vertices) for p in o.data.polygons]
+t = BVHTree.FromPolygons(sv, pl, all_triangles=False, epsilon=0.0)
+up = Vector((0,0,1.0))
+
+def dedans(x,z):
+    n=0; dep=Vector((x,Y,z))
+    for _ in range(64):
+        h=t.ray_cast(dep,up,60.0)
+        if h is None or h[0] is None: break
+        n+=1; dep=h[0]+up*1e-4
+    return n%2==1
+
+W=int(round((X1-X0)/PAS)); H=int(round((Z1-Z0)/PAS))
+roche=[[dedans(X0+(i+0.5)*PAS, Z0+(j+0.5)*PAS) for j in range(H)] for i in range(W)]
+print("[edt] grille %dx%d, pas %.3f m, plan y=%.2f" % (W,H,PAS,Y))
+
+INF=1e18
+def edt1d(f):
+    n=len(f); v=[0]*n; z=[0.0]*(n+1); k=0; v[0]=0; z[0]=-INF; z[1]=INF
+    for q in range(1,n):
+        while True:
+            s=((f[q]+q*q)-(f[v[k]]+v[k]*v[k]))/(2.0*q-2.0*v[k])
+            if s<=z[k]: k-=1
+            else: break
+        k+=1; v[k]=q; z[k]=s; z[k+1]=INF
+    k=0; out=[0.0]*n
+    for q in range(n):
+        while z[k+1]<q: k+=1
+        out[q]=(q-v[k])**2+f[v[k]]
+    return out
+
+# EDT^2 sur les cellules de ROCHE, distance au VIDE le plus proche
+g=[[0.0 if not roche[i][j] else INF for j in range(H)] for i in range(W)]
+for i in range(W): g[i]=edt1d(g[i])
+cols=[[g[i][j] for i in range(W)] for j in range(H)]
+for j in range(H): cols[j]=edt1d(cols[j])
+dt=[[math.sqrt(cols[j][i])*PAS for j in range(H)] for i in range(W)]
+
+# composantes de vide : celle du dehors (bord de grille) et celle de l'ouverture
+def compo(depart):
+    vu=[[False]*H for _ in range(W)]; pile=list(depart)
+    for i,j in depart: vu[i][j]=True
+    while pile:
+        i,j=pile.pop()
+        for di,dj in ((1,0),(-1,0),(0,1),(0,-1)):
+            a,b=i+di,j+dj
+            if 0<=a<W and 0<=b<H and not vu[a][b] and not roche[a][b]:
+                vu[a][b]=True; pile.append((a,b))
+    return vu
+bord=[(i,j) for i in range(W) for j in (0,H-1) if not roche[i][j]] + \
+     [(i,j) for j in range(H) for i in (0,W-1) if not roche[i][j]]
+dehors=compo(bord)
+ia=int((0.0-X0)/PAS); ja=int((1.10-Z0)/PAS)
+if roche[ia][ja]: sys.exit("[edt] ERREUR: le point d'ouverture est dans la roche")
+ouv=compo([(ia,ja)])
+print("[edt] l'ouverture est-elle DEJA reliee au dehors ? %s" % dehors[ia][ja])
+
+# goulot : union-find sur cellules de roche triees par dt croissante
+parent=list(range(W*H+2)); DEH=W*H; OUV=W*H+1
+def rac(x):
+    while parent[x]!=x: parent[x]=parent[parent[x]]; x=parent[x]
+    return x
+def uni(a,b):
+    ra,rb=rac(a),rac(b)
+    if ra!=rb: parent[ra]=rb
+actif=[[False]*H for _ in range(W)]
+cells=sorted(((dt[i][j],i,j) for i in range(W) for j in range(H) if roche[i][j]))
+seuil=None; ou=None
+for d,i,j in cells:
+    actif[i][j]=True; k=i*H+j
+    for di in (-1,0,1):
+        for dj in (-1,0,1):
+            a,b=i+di,j+dj
+            if not (0<=a<W and 0<=b<H) or (di==0 and dj==0): continue
+            if roche[a][b] and actif[a][b]: uni(k,a*H+b)
+            elif not roche[a][b]:
+                if dehors[a][b]: uni(k,DEH)
+                if ouv[a][b]: uni(k,OUV)
+    if rac(DEH)==rac(OUV):
+        seuil=d; ou=(X0+(i+0.5)*PAS, Z0+(j+0.5)*PAS); break
+print("[edt] GOULOT : demi-epaisseur %.4f m -> COLLERETTE %.4f m, au (x %.2f, z %.2f)"
+      % (seuil, 2.0*seuil, ou[0], ou[1]))
+# profil : max de dt le long du bandeau, par tranche de z, cote droit
+print("[edt] plus grande dt de roche par tranche z, cote x>0.6 (m) :")
+for jz in range(0,H,5):
+    z=Z0+(jz+0.5)*PAS
+    best=0.0; bx=None
+    for i in range(W):
+        x=X0+(i+0.5)*PAS
+        if x>0.6 and roche[i][jz] and dt[i][jz]>best: best,bx=dt[i][jz],x
+    if bx is not None and z<3.0:
+        print("[edt]   z=%5.2f  2*dt=%.3f m  a x=%.2f" % (z,2*best,bx))
