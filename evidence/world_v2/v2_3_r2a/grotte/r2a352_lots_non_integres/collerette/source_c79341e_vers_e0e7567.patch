+"""Épaisseur de la COLLERETTE du porche, par DEUX méthodes indépendantes.
+
+    blender --background <blend> --python-exit-code 1 \
+        --python tools/blender/probe_cave_collerette.py -- [--seuil 0.60]
+
+Ne juge rien tant que `--seuil` n'est pas donné : il imprime, et rend 0. Avec
+`--seuil`, il rend 1 si `min(A, B)` passe dessous. Il ne modifie aucune
+géométrie et n'enregistre rien.
+
+═══════════════════════════════════════════════════════════════════════════
+POURQUOI DEUX MÉTHODES, ET PAS UNE DE PLUS PRÉCISE
+═══════════════════════════════════════════════════════════════════════════
+
+La faute récurrente de ce chantier — neuf fois — est *un seul nombre, qui
+répond à une autre question que celle posée*. Sur la collerette elle s'est
+produite en toutes lettres : `controle_epaisseur()` a rapporté « 0,48 m pour
+0,60 exigés » pendant que **25 rayons sur 33 ne rencontraient aucune roche**
+au porche. Le 0,48 était le minimum des sept rayons survivants — donc le
+minimum d'un périmètre TROUÉ, présenté comme le minimum d'un périmètre.
+
+Un seul rayon qui effleure une arête vive n'est pas une preuve. Les deux
+méthodes ci-dessous sont retenues parce qu'elles **échouent différemment** :
+
+  * A — RAYON SELON LA NORMALE LOCALE de la paroi. Il ne peut pas longer la
+    galerie, faute qui affecte `controle_epaisseur` près du coude (mesuré :
+    `r_in` = 3,99 m pour une demi-largeur propre de 1,58 m, parce que ses
+    rayons partent de l'axe dans le plan monde `(cos θ, 0, sin θ)`). Il peut
+    en revanche raser une arête ;
+  * B — SPHÈRE INSCRITE. Sans direction du tout, donc insensible à une
+    arête rasée comme à un rayon qui file parallèlement à une plaque mince.
+    Il sous-estime en revanche là où la roche est un coin.
+
+Le verdict rapporté est **`min(A, B)` et la position du minimum**, jamais un
+scalaire seul. Quand les deux s'écartent de plus de `ECART_ALERTE_M`, le
+journal le dit : c'est le signe qu'une des deux mesure autre chose.
+
+═══════════════════════════════════════════════════════════════════════════
+LA DÉFINITION DU BORD DE L'OUVERTURE — TRANCHÉE, ET ÉCRITE ICI
+═══════════════════════════════════════════════════════════════════════════
+
+Deux sondes qui mesurent « le bord de l'ouverture » sans en partager la
+définition mesurent deux bords, et l'écart n'apparaît qu'à l'intégration.
+La définition retenue pour tout le chantier, décidée le 2026-08-16 :
+
+    LE BORD DE L'OUVERTURE EST LE RIM TOPOLOGIQUE : l'ensemble des ARÊTES
+    du maillage livré dont les deux faces adjacentes appartiennent, l'une à
+    la trace de cavité (matière `MAT_CaveIn_*`), l'autre à la roche
+    (matière `MAT_CaveRock_*`).
+
+Elle est exacte, sans paramètre et sans seuil : elle ne dépend d'aucune
+distance, d'aucun plan de coupe et d'aucune station. Elle survit au booléen
+parce que la soustraction conserve les matières de l'outil — vérifié sur le
+livrable : 561 faces `MAT_CaveIn_*` contre 16 799 faces de roche.
+
+Et elle est la bonne : la bouche n'est pas dessinée, c'est la TRACE DE
+DÉCOUPE du tube dans la roche (voir `cavite_solide`). Son contour est donc,
+littéralement, la frontière entre la matière de l'outil et celle de la
+roche.
+
+CE QU'ELLE N'EST PAS. Ce n'est pas « la station 0 », ni « le plan
+y = -1,15 », ni « le contour de l'anneau du porche » : ces trois-là sont des
+objets du GÉNÉRATEUR, pas du maillage livré, et ils ne coïncident avec le
+bord visible que par accident. Le rim, lui, est là où le joueur le voit.
+
+═══════════════════════════════════════════════════════════════════════════
+CE QUE LA SONDE MESURE, ET CE QU'ELLE NE MESURE PAS
+═══════════════════════════════════════════════════════════════════════════
+
+Elle mesure la roche qui SÉPARE LA GALERIE DU DEHORS au voisinage du rim.
+Elle ne mesure ni le plancher (qui relève du terrain gelé, voir
+`controle_epaisseur`), ni la lisibilité de la forme : qu'une visière se lise
+comme de la roche et non comme une arche est une question d'œil, elle
+demande un rendu et une revue, pas une sonde.
+"""
+
+import math
+import sys
+
+import bpy
+from mathutils import Vector
+from mathutils.bvhtree import BVHTree
+
+OBJET = "SM_WaterfallCave"
+PREFIXE_CAVITE = "MAT_CaveIn_"
+PREFIXE_ROCHE = "MAT_CaveRock_"
+
+## Bande de paroi échantillonnée autour du rim. La collerette est ce qui
+## borde la bouche ; au-delà de 1,60 m on mesure la paroi ordinaire, dont le
+## seuil est un autre (0,80 m) et le contrôle un autre aussi.
+BANDE_RIM_M = 1.60
+## RECUL MINIMAL — ET CE N'EST PAS UN RÉGLAGE DE CONFORT.
+##
+## SUR LE RIM, L'ÉPAISSEUR EST NULLE PAR CONSTRUCTION : c'est l'arête où la
+## peau de la cavité et la peau de la roche se touchent. Les deux méthodes y
+## rendent zéro, et elles ont raison — elles mesurent alors l'arête, pas la
+## collerette. Première exécution de cette sonde, sans recul : 0,08 m à
+## (-2,17 ; -1,44 ; 1,45), un point situé à 6 cm derrière le rim, pendant que
+## `controle_epaisseur` mesurait 0,73 m au plan de la station 0. Les deux
+## chiffres étaient exacts ; ils ne mesuraient pas au même endroit. C'est
+## encore *un seul nombre qui répond à une autre question*, cette fois
+## fabriqué par ma propre sonde.
+##
+## On mesure donc à partir de 0,30 m derrière le bord, et le profil complet
+## par bande de 0,20 m est IMPRIMÉ : une collerette saine montre une
+## épaisseur qui croît avec le recul ; une collerette mince montre un profil
+## plat et bas. Le lecteur voit la croissance, donc il peut juger le choix de
+## 0,30 au lieu de le subir.
+##
+## LIMITE CONNUE, ET ELLE MORD SUR UN SURPLOMB. 0,30 m suffit quand la paroi
+## rencontre le bord FRANCHEMENT. Sur une lèvre en surplomb, la roche forme
+## un BISEAU à faible angle : à 0,30 m derrière l'arête on est encore dans le
+## coin, et le chiffre décrit le biseau, pas la collerette. Mesuré le
+## 2026-08-16 sur la visière du porche — minimum 0,32 m dans la bande
+## 0,2-0,4, puis 0,62 · 1,56 · 1,82 dans les trois bandes suivantes. Le
+## profil rend la chose LISIBLE, et c'est pour cela qu'il est imprimé : un
+## minimum bas dont les bandes voisines montent en flèche est un biseau ; un
+## minimum bas suivi d'un profil plat est une paroi mince.
+##
+## On ne relève PAS `RECUL_MIN_M` pour faire passer une géométrie : ce serait
+## remplacer l'attendu par le mesuré. Là où le biseau domine, la grandeur qui
+## décide est la collerette DANS LE PLAN DE BOUCHE, par transformée de
+## distance — une mesure 3D est structurellement OPTIMISTE sur un jambage,
+## parce que la sphère s'échappe le long de Y, et PESSIMISTE sur un biseau.
+RECUL_MIN_M = 0.30
+PAS_BANDE_M = 0.20
+## Une écaille n'est pas une paroi — même convention que le tronc.
+ECAILLE_M = 0.05
+## Pas de marche vers l'intérieur de la roche pour la sphère inscrite, et
+## profondeur maximale explorée. 0,04 m donne le rayon à ±2 cm sans faire
+## exploser le nombre de requêtes.
+PAS_SPHERE_M = 0.04
+PROFONDEUR_SPHERE_M = 2.40
+## Au-delà, A et B ne décrivent visiblement pas la même roche : on le dit.
+## L'alerte ne se déclenche que là où la mesure DÉCIDE encore quelque chose
+## — sous `ECART_PORTEE_M` de roche. Au-delà, A traverse le massif entier et
+## B reste bornée par le coin local : leur écart y est attendu, énorme, et
+## ne renseigne sur rien. Une alerte qui crie toujours finit ignorée.
+ECART_ALERTE_M = 0.45
+ECART_PORTEE_M = 1.50
+## Le rayon ne peut pas être décidé sur un point posé EXACTEMENT sur la
+## surface : on décolle d'autant avant de partir.
+DECOLLAGE_M = 1e-3
+
+
+def _sortir(code, message):
+    print("[collerette] %s" % message)
+    sys.exit(code)
+
+
+def _options():
+    argv = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else []
+    seuil = None
+    if "--seuil" in argv:
+        seuil = float(argv[argv.index("--seuil") + 1])
+    return seuil
+
+
+def _familles(maillage):
+    """Rend, par index de slot, 'cavite' | 'roche' | None."""
+    sortie = []
+    for mat in maillage.materials:
+        nom = mat.name if mat else ""
+        if nom.startswith(PREFIXE_CAVITE):
+            sortie.append("cavite")
+        elif nom.startswith(PREFIXE_ROCHE):
+            sortie.append("roche")
+        else:
+            sortie.append(None)
+    return sortie
+
+
+def rim_topologique(maillage, famille):
+    """LES ARÊTES DU BORD DE L'OUVERTURE — voir la définition en tête.
+
+    Rend (liste d'arêtes `(ia, ib, milieu)`). Une arête est du rim si ses
+    deux faces adjacentes sont de familles différentes et non nulles. On
+    passe par un index arête -> faces construit à la main : le maillage
+    livré est un n-gone décimé, `edge.link_faces` n'existe qu'en bmesh et
+    coûte une conversion complète pour la même information.
+    """
+    par_arete = {}
+    for poly in maillage.polygons:
+        fam = famille[poly.material_index] if \
+            poly.material_index < len(famille) else None
+        for cle in poly.edge_keys:
+            par_arete.setdefault(cle, []).append(fam)
+    aretes = []
+    for (a, b), fams in par_arete.items():
+        if len(fams) != 2:
+            continue                      # arête de bord : le maillage est
+        if None in fams or fams[0] == fams[1]:   # fermé, cela n'arrive pas
+            continue
+        milieu = (maillage.vertices[a].co + maillage.vertices[b].co) * 0.5
+        aretes.append((a, b, milieu))
+    return aretes
+
+
+def boucles(aretes):
+    """LE RIM SE SÉPARE EN BOUCLES, ET ON NE LES MÉLANGE PAS.
+
+    Mesuré le 2026-08-16, et c'est la raison d'être de cette fonction : le
+    rim du livrable compte 167 arêtes, dont 155 bordent la bouche et **10
+    se trouvent à y ≈ 6**, c'est-à-dire au fond de la salle. Prendre le
+    minimum sur l'ensemble rendait 0,05 m — un chiffre exact, et qui ne
+    parle PAS de la collerette. Une sonde qui fond deux bords en un seul
+    nombre refait la faute qu'elle est censée attraper.
+
+    On regroupe donc par composantes connexes du graphe d'arêtes (union par
+    indice de sommet), on mesure CHAQUE boucle séparément, et le journal les
+    imprime toutes. Rien n'est écarté : la boucle de la bouche donne le
+    verdict de collerette, les autres sont rapportées comme des constats à
+    part entière.
+    """
+    parent = {}
+
+    def racine(x):
+        while parent.setdefault(x, x) != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
+
+    for a, b, _ in aretes:
+        ra, rb = racine(a), racine(b)
+        if ra != rb:
+            parent[ra] = rb
+    groupes = {}
+    for a, b, milieu in aretes:
+        groupes.setdefault(racine(a), []).append((a, b, milieu))
+    return sorted(groupes.values(), key=len, reverse=True)
+
+
+def echantillons(maillage, famille, milieux):
+    """Points de PAROI DE GALERIE à moins de `BANDE_RIM_M` d'une boucle.
+
+    On échantillonne la paroi et non le rim lui-même : sur le rim, la roche
+    est nulle par définition — les deux surfaces s'y touchent. La collerette
+    est ce qu'il y a DERRIÈRE le bord, pas le bord.
+    """
+    if not milieux:
+        return []
+    sortie = []
+    for poly in maillage.polygons:
+        fam = famille[poly.material_index] if \
+            poly.material_index < len(famille) else None
+        if fam != "cavite":
+            continue
+        centre = Vector(poly.center)
+        d = min((centre - p).length for p in milieux)
+        if d <= BANDE_RIM_M:
+            sortie.append((centre, Vector(poly.normal), d))
+    return sortie
+
+
+def _vers_la_roche(arbre, point, normale):
+    """La normale de la face, orientée VERS LA ROCHE.
+
+    L'orientation des faces de trace n'est pas supposée : on teste. Un point
+    décollé de la surface est dans la roche si un rayon vertical qui en part
+    croise la peau un nombre IMPAIR de fois. On essaie `-n` puis `+n`, et si
+    aucune des deux ne tombe dans la matière on rend None — le point est
+    rejeté et compté, jamais absous.
+    """
+    for signe in (-1.0, 1.0):
+        d = normale * signe
+        essai = point + d * 0.02
+        n = 0
+        depart = essai.copy()
+        haut = Vector((0.0, 0.0, 1.0))
+        for _ in range(64):
+            t = arbre.ray_cast(depart, haut, 80.0)
+            if t is None or t[0] is None:
+                break
+            n += 1
+            depart = t[0] + haut * 1e-4
+        if n % 2 == 1:
+            return d
+    return None
+
+
+def methode_a(arbre, point, direction):
+    """RAYON SELON LA NORMALE LOCALE : roche cumulée jusqu'à la sortie.
+
+    Même arithmétique d'intervalles que `controle_epaisseur` — entrée et
+    sortie distinguées par le signe de `normale · direction`, écailles de
+    moins de `ECAILLE_M` comptées et ignorées — mais la direction est celle
+    de la PAROI, pas un azimut monde pris depuis l'axe. C'est tout l'écart,
+    et c'est celui qui compte : un rayon parti de l'axe peut descendre LE
+    LONG de la galerie ; un rayon parti de la paroi selon sa normale, non.
+    """
+    origine = point + direction * DECOLLAGE_M
+    depart = origine.copy()
+    entree, epaisseur, ecailles, impacts = None, None, 0, 0
+    for _ in range(24):
+        t = arbre.ray_cast(depart, direction, 60.0)
+        if t is None or t[0] is None:
+            break
+        impacts += 1
+        distance = (t[0] - origine).length
+        sortant = t[1].dot(direction) > 0.0
+        if entree is None and not sortant:
+            entree = distance
+        elif entree is not None and sortant:
+            intervalle = distance - entree
+            if intervalle < ECAILLE_M:
+                ecailles += 1
+            else:
+                epaisseur = (epaisseur or 0.0) + intervalle
+            entree = None
+        elif entree is None and sortant:
+            # Parti DANS la matière : la première sortie borne l'épaisseur.
+            if distance >= ECAILLE_M:
+                epaisseur = (epaisseur or 0.0) + distance
+            else:
+                ecailles += 1
+        depart = t[0] + direction * 1e-4
+    return epaisseur, impacts, ecailles
+
+
+def methode_b(arbre, point, direction):
+    """SPHÈRE INSCRITE : 2 × le plus grand rayon d'une boule intérieure.
+
+    On avance dans la roche par pas de `PAS_SPHERE_M` le long de la normale
+    et, à chaque pas, `find_nearest` donne la distance au bord le plus
+    proche — c'est-à-dire le rayon de la plus grande boule centrée là qui ne
+    déborde pas. L'épaisseur locale est `2 · r`, prise à son maximum tant
+    que le centre reste dans la matière.
+
+    POURQUOI ON S'ARRÊTE À LA PREMIÈRE DÉCROISSANCE et non au bout de la
+    course : au-delà de l'axe médian de la paroi, la boule regrandit en
+    s'approchant d'une AUTRE partie du solide, et l'on mesurerait alors le
+    massif, plus la collerette. Le maximum local est le bon.
+    """
+    meilleur, precedent = 0.0, -1.0
+    d = PAS_SPHERE_M
+    while d <= PROFONDEUR_SPHERE_M:
+        centre = point + direction * d
+        touche = arbre.find_nearest(centre, 30.0)
+        if touche is None or touche[0] is None:
+            break
+        r = (touche[0] - centre).length
+        if r < precedent - 1e-6:
+            break
+        precedent = r
+        meilleur = max(meilleur, 2.0 * r)
+        d += PAS_SPHERE_M
+    return meilleur if meilleur > 0.0 else None
+
+
+def _lieu(p):
+    return "(%.2f, %.2f, %.2f)" % (p.x, p.y, p.z) if p else "(aucun)"
+
+
+def mesurer_boucle(maillage, famille, arbre, boucle):
+    """Rend le dictionnaire de mesure d'UNE boucle de rim.
+
+    `min_a` / `min_b` ne retiennent que les points AU-DELÀ de `RECUL_MIN_M`
+    derrière le bord — voir la justification de cette constante. Le profil
+    par bande, lui, couvre tout le recul, y compris la zone d'arête, pour
+    que le choix du recul reste vérifiable au lieu d'être caché.
+    """
+    milieux = [m for _, _, m in boucle]
+    ech = echantillons(maillage, famille, milieux)
+    res = dict(aretes=len(boucle), faces=len(ech), rejets=0, sans_a=0,
+               sans_b=0, ecailles=0, min_a=1e9, min_b=1e9, ou_a=None,
+               ou_b=None, ecart=0.0, ou_ecart=None, bandes={}, sondes=0,
+               bbox=(Vector((min(m.x for m in milieux),
+                             min(m.y for m in milieux),
+                             min(m.z for m in milieux))),
+                     Vector((max(m.x for m in milieux),
+                             max(m.y for m in milieux),
+                             max(m.z for m in milieux)))))
+    for centre, normale, recul in ech:
+        direction = _vers_la_roche(arbre, centre, normale)
+        if direction is None:
+            res["rejets"] += 1
+            continue
+        a, _, ec = methode_a(arbre, centre, direction)
+        res["ecailles"] += ec
+        b = methode_b(arbre, centre, direction)
+        bande = int(recul / PAS_BANDE_M)
+        sac = res["bandes"].setdefault(bande, [0, 1e9, 0])
+        sac[0] += 1
+        if a is not None and b is not None:
+            sac[1] = min(sac[1], min(a, b))
+        else:
+            sac[2] += 1
+        if recul < RECUL_MIN_M:
+            continue
+        res["sondes"] += 1
+        if a is None:
+            res["sans_a"] += 1
+        elif a < res["min_a"]:
+            res["min_a"], res["ou_a"] = a, centre.copy()
+        if b is None:
+            res["sans_b"] += 1
+        elif b < res["min_b"]:
+            res["min_b"], res["ou_b"] = b, centre.copy()
+        if a is not None and b is not None and min(a, b) < ECART_PORTEE_M \
+                and abs(a - b) > res["ecart"]:
+            res["ecart"], res["ou_ecart"] = abs(a - b), centre.copy()
+    res["verdict"] = min(res["min_a"], res["min_b"])
+    res["ou"] = res["ou_a"] if res["min_a"] <= res["min_b"] else res["ou_b"]
+    return res
+
+
+def main():
+    seuil = _options()
+    if OBJET not in bpy.data.objects:
+        _sortir(2, "ERREUR: objet %s absent du .blend" % OBJET)
+    maillage = bpy.data.objects[OBJET].data
+    famille = _familles(maillage)
+    if "cavite" not in famille or "roche" not in famille:
+        _sortir(2, "ERREUR: le maillage ne porte pas les deux familles de "
+                   "matiere (%s) — la definition du rim est inapplicable"
+                % [m.name if m else None for m in maillage.materials])
+
+    aretes = rim_topologique(maillage, famille)
+    print("[collerette] rim topologique : %d arete(s) entre trace de cavite "
+          "et roche" % len(aretes))
+    if not aretes:
+        _sortir(2, "ERREUR: rim vide — soit la bouche n'existe pas, soit les "
+                   "matieres n'ont pas survecu au booleen")
+    lots = boucles(aretes)
+    print("[collerette] %d boucle(s) de rim, mesurees SEPAREMENT (voir "
+          "`boucles`)" % len(lots))
+
+    sommets = [v.co.copy() for v in maillage.vertices]
+    polys = [tuple(p.vertices) for p in maillage.polygons]
+    arbre = BVHTree.FromPolygons(sommets, polys, all_triangles=False,
+                                 epsilon=0.0)
+
+    mesures = [mesurer_boucle(maillage, famille, arbre, b) for b in lots]
+
+    # LA BOUCHE EST LA BOUCLE LA PLUS EN AVANT. Pas la plus grande : une
+    # boucle intérieure pourrait un jour la dépasser en nombre d'arêtes.
+    # La bouche est le seul bord de trace qui donne sur le dehors, et le
+    # dehors est vers -Y ; on prend donc le minimum de y du rim.
+    i_bouche = min(range(len(mesures)), key=lambda i: mesures[i]["bbox"][0].y)
+
+    for i, m in enumerate(mesures):
+        lo, hi = m["bbox"]
+        etiquette = "BOUCHE" if i == i_bouche else "autre "
+        print("[collerette] boucle %d [%s] : %3d aretes, %3d faces sondees, "
+              "x %.2f..%.2f  y %.2f..%.2f  z %.2f..%.2f"
+              % (i, etiquette, m["aretes"], m["faces"], lo.x, hi.x, lo.y,
+                 hi.y, lo.z, hi.z))
+        if m["rejets"]:
+            print("[collerette]   %d point(s) REJETE(S) : aucune des deux "
+                  "normales ne mene dans la matiere — comptes, jamais absous"
+                  % m["rejets"])
+        if m["ecailles"]:
+            print("[collerette]   %d ecaille(s) de moins de %.2f m ignoree(s)"
+                  % (m["ecailles"], ECAILLE_M))
+        if m["sans_a"]:
+            print("[collerette]   ERREUR: %d point(s) ou A ne trouve AUCUNE "
+                  "roche — le rayon sort par un jour" % m["sans_a"])
+        if m["sans_b"]:
+            print("[collerette]   ERREUR: %d point(s) ou B ne trouve aucune "
+                  "boule interieure" % m["sans_b"])
+        profil = " ".join(
+            "%.1f-%.1f:%s%s" % (b * PAS_BANDE_M, (b + 1) * PAS_BANDE_M,
+                                "--" if v[1] > 1e8 else "%.2f" % v[1],
+                                "!" if v[2] else "")
+            for b, v in sorted(m["bandes"].items()))
+        print("[collerette]   profil min(A,B) par recul derriere le bord "
+              "(m) : %s" % profil)
+        print("[collerette]   %d sonde(s) retenue(s) au-dela de %.2f m de "
+              "recul" % (m["sondes"], RECUL_MIN_M))
+        print("[collerette]   A (rayon normale locale) %.2f m au %s"
+              % (m["min_a"], _lieu(m["ou_a"])))
+        print("[collerette]   B (sphere inscrite)      %.2f m au %s"
+              % (m["min_b"], _lieu(m["ou_b"])))
+        print("[collerette]   ecart A/B maximal %.2f m au %s (alerte > %.2f, "
+              "seulement sous %.2f m de roche)"
+              % (m["ecart"], _lieu(m["ou_ecart"]), ECART_ALERTE_M,
+                 ECART_PORTEE_M))
+        if m["ecart"] > ECART_ALERTE_M:
+            print("[collerette]   ATTENTION: A et B s'ecartent de plus de "
+                  "%.2f m — l'une des deux ne mesure pas la meme roche que "
+                  "l'autre, et le minimum seul ne suffit pas a conclure"
+                  % ECART_ALERTE_M)
+        print("[collerette]   min(A, B) = %.2f m au %s"
+              % (m["verdict"], _lieu(m["ou"])))
+
+    bouche = mesures[i_bouche]
+    print("[collerette] VERDICT COLLERETTE (boucle %d) min(A, B) = %.2f m "
+          "au %s" % (i_bouche, bouche["verdict"], _lieu(bouche["ou"])))
+    autres = [m for i, m in enumerate(mesures) if i != i_bouche]
+    if autres:
+        pire = min(autres, key=lambda m: m["verdict"])
+        print("[collerette] HORS COLLERETTE — le plus mince des autres bords "
+              "de trace : %.2f m au %s. Ce n'est PAS la collerette et ce "
+              "n'est pas jugé ici ; c'est rapporté parce qu'un bord de trace "
+              "loin de la bouche est un fait, pas un detail."
+              % (pire["verdict"], _lieu(pire["ou"])))
+
+    if bouche["sans_a"] or bouche["sans_b"]:
+        _sortir(1, "ROUGE: la collerette presente au moins un jour")
+    if seuil is not None:
+        if bouche["verdict"] < seuil:
+            _sortir(1, "ROUGE: %.2f m sous le seuil de %.2f m"
+                    % (bouche["verdict"], seuil))
+        print("[collerette] VERT: %.2f m au-dessus du seuil de %.2f m"
+              % (bouche["verdict"], seuil))
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
