+def _a_bord_colineaire(face, tolerance=1e-9):
+    """Le BORD de ce polygone porte-t-il trois sommets consécutifs alignés ?
+
+    C'est la signature exacte d'une T-jonction posée sur un n-gone, et donc
+    le seul cas où la triangulation peut produire une oreille d'aire nulle.
+    On teste l'aire du triangle (p, q, r) formé par chaque triplet
+    consécutif du contour : nulle = alignés.
+
+    Le seuil est en m2 et volontairement minuscule : on cherche des points
+    EXACTEMENT alignés (le cas mesuré a `b` au milieu exact de `a-c`, donc
+    un produit vectoriel nul au bit près), pas des angles très ouverts.
+    """
+    n = len(face.verts)
+    if n < 4:
+        return False
+    co = [v.co for v in face.verts]
+    for i in range(n):
+        p, q, r = co[i], co[(i + 1) % n], co[(i + 2) % n]
+        if (q - p).cross(r - p).length * 0.5 <= tolerance:
+            return True
+    return False
+
