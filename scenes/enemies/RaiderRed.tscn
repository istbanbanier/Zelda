[node name="Pivot" type="Node3D" parent="."]

; ART-Q2 : adaptateur du modèle riggé (char.raider_red). S'il résout, le
; graybox se masque et le gourdin rejoint la main animée ; sinon repli
; total. Capsule et volumes de combat inchangés.
[node name="CharacterVisual" type="Node3D" parent="Pivot"]
script = ExtResource("9_visual")
model_id = &"char.raider_red"
anim_set = ExtResource("10_animset")

[node name="BodyMesh" type="MeshInstance3D" parent="Pivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
mesh = SubResource("BodyMesh")
surface_material_override/0 = SubResource("RaiderMat")

; Volume de frappe du gourdin : devant le pivot (+Z local), à hauteur de torse.
[node name="ClubHitbox" type="Area3D" parent="Pivot"]
