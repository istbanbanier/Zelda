[gd_scene load_steps=5 format=3]

; V4 lot 13 — la capuche/mantille est re-teinte turquoise DANS la texture
; dérivée T_Ranger_Hero_BaseColor (tools/godot/recolor_hero_hood.gd) : la
; peau et le cuir gardent leurs couleurs — fini la teinte globale.
; ART-Q1 — héros de production : modèle Male_Ranger (Quaternius CC0) +
; AnimationPlayer chargé de la bibliothèque CUITE AL_HeroStates.res
; (12 états, in-place, audit de root motion dans evidence/artQ1/).
; root_node vise le modèle : les pistes "Armature/Skeleton3D:<os>" des
; clips UAL résolvent directement — squelettes identiques (65 os).
; Face du modèle = +Z local, convention du NoseMesh graybox.

[ext_resource type="Script" path="res://scripts/characters/character_model_sockets.gd" id="1_model_script"]
[ext_resource type="PackedScene" path="res://assets/characters/hero/Male_Ranger.gltf" id="2_ranger"]
[ext_resource type="AnimationLibrary" path="res://assets/animations/AL_HeroStates.res" id="3_states"]
[ext_resource type="Texture2D" path="res://assets/characters/hero/T_Ranger_Hero_BaseColor.png" id="4_hero_tex"]

[node name="HeroVisual" type="Node3D"]
script = ExtResource("1_model_script")
albedo_substitutions = Dictionary[String, Texture2D]({
"MI_Ranger": ExtResource("4_hero_tex")
})

[node name="Model" parent="." instance=ExtResource("2_ranger")]

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("../Model")
libraries = {
&"": ExtResource("3_states")
}
autoplay = "Idle"
