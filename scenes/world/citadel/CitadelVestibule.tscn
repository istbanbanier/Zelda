[gd_scene load_steps=4 format=3]

; Vestibule graybox de la citadelle (D.1R.4). Le décor est construit par le
; script — cette scène ne porte que le joueur, la coquille et l'entrée.

[ext_resource type="Script" path="res://scripts/world/citadel_vestibule.gd" id="1_vestibule"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/GameplayShell.tscn" id="3_shell"]

[node name="CitadelVestibule" type="Node3D"]
script = ExtResource("1_vestibule")

[node name="GameplayShell" parent="." instance=ExtResource("3_shell")]
; ISS-073 — « Réessayer » recharge `world_scene_path`, dont la valeur PAR
; DÉFAUT est la vallée V1. Mourir dans le vestibule y déposait donc le
; joueur, dans un monde qu'il n'a jamais traversé. Les six salles du
; donjon et l'arène surchargent déjà cette valeur avec elles-mêmes ; le
; vestibule ne le faisait pas.
world_scene_path = "res://scenes/world/citadel/CitadelVestibule.tscn"

; Le joueur entre par la porte sud, face au fond (regard -Z).
[node name="Player" parent="." instance=ExtResource("2_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.2, 11.2)

[node name="VisualRoot" parent="Player"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
