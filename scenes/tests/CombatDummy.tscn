[gd_scene load_steps=8 format=3]

; Mannequin d'entraînement (§10.8). Corps sur la couche Enemy (3), hurtbox sur la
; couche Hurtbox (6), équipe `enemies`. La santé par défaut (45) est celle du
; pillard braise (§12.1). Le combo complet d'épée usée fait 40,2 : le mannequin
; y survit de justesse, et tombe au coup suivant — quatre coups en tout.

[ext_resource type="Script" path="res://scripts/tools/combat_dummy.gd" id="1_dummy"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="2_health"]
[ext_resource type="Script" path="res://scripts/components/hurtbox_component.gd" id="3_hurtbox"]

[sub_resource type="CapsuleShape3D" id="BodyShape"]
radius = 0.4
height = 1.7

[sub_resource type="CapsuleShape3D" id="HurtShape"]
radius = 0.45
height = 1.7

[sub_resource type="CapsuleMesh" id="BodyMesh"]
radius = 0.4
height = 1.7

[sub_resource type="StandardMaterial3D" id="DummyMat"]
albedo_color = Color(0.62, 0.32, 0.28, 1)

[node name="CombatDummy" type="StaticBody3D" groups=["enemies", "damageable", "lock_on_targets"]]
collision_layer = 4
collision_mask = 0
script = ExtResource("1_dummy")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, 0)
shape = SubResource("BodyShape")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, 0)
mesh = SubResource("BodyMesh")
surface_material_override/0 = SubResource("DummyMat")

[node name="HealthComponent" type="Node" parent="."]
script = ExtResource("2_health")
max_health = 45.0

[node name="Hurtbox" type="Area3D" parent="."]
collision_layer = 32
collision_mask = 0
script = ExtResource("3_hurtbox")
team = &"enemies"
health_path = NodePath("../HealthComponent")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Hurtbox"]
