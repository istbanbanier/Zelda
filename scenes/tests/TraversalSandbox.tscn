; --- Escalade (§9.2) et mantle (§9.3) -------------------------------------
; Chaque paroi isole UN cas. Une seule paroi « générique » ne pourrait pas
; distinguer un refus de surface d'un refus de dégagement, et un test qui échoue
; ne dirait pas pourquoi.

; Paroi de 4 m, dessus dégagé : escalade complète puis franchissement.
[node name="ClimbWall" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5, 2, -30)
collision_layer = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="ClimbWall"]
shape = SubResource("ClimbWallShape")

; Même géométrie, groupe `unclimbable` : §9.2 exige qu'elle soit refusée.
; Sans ce jumeau, un test d'accroche ne distinguerait pas « la surface est
; interdite » de « la sonde n'a rien touché ».
[node name="UnclimbableWall" type="StaticBody3D" parent="." groups=["unclimbable"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -25, 2, -30)
collision_layer = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="UnclimbableWall"]
shape = SubResource("ClimbWallShape")

; Rebord bas : franchissement atteint en quelques dixièmes de seconde.
[node name="LowLedge" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12, 0.6, -30)
collision_layer = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="LowLedge"]
shape = SubResource("LowLedgeShape")

; Rebord bas surmonté d'un plafond : le cas manuel de §21.4 « tenter mantle sous
; plafond ». Le dessus est marchable, mais la capsule n'y tient pas.
[node name="CappedLedge" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 28, 0.6, -30)
collision_layer = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="CappedLedge"]
shape = SubResource("LowLedgeShape")

[node name="Ceiling" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 28, 2.6, -30.7)
collision_layer = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="Ceiling"]
shape = SubResource("CapShape")

; Paroi flottant de y = 0,8 à y = 3,0 : le torse la touche, les pieds sont dans le
; vide. §9.2 refuse « vides/concavités » — s'y accrocher laisserait le personnage
; pendre sans appui. Sans cette géométrie, la branche `overhang` n'était couverte
; par aucun test : le contrôle négatif P2 l'a démontré en ne cassant rien.
[node name="OverhangWall" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -15, 1.9, -30)
collision_layer = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="OverhangWall"]
shape = SubResource("OverhangShape")

; Marche de 0,32 m — franchissable — mais surmontée d'un plafond à 1,90 m : la
; capsule tient debout dessous, pas une fois surélevée d'une hauteur de marche.
; Le franchissement doit donc être refusé, et le joueur rester en bas plutôt que
; de s'encastrer. Sans cette géométrie, le refus de dégagement de `_try_step_up()`
; ne serait couvert par aucun test — l'erreur exacte qu'un contrôle négatif a
; révélée en B.3 sur le refus des surplombs.
[node name="LowCeilingStep" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -36, 0.16, -30)
collision_layer = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="LowCeilingStep"]
shape = SubResource("LowStepShape")

[node name="LowCeiling" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -36, 2.0, -28.5)
collision_layer = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="LowCeiling"]
shape = SubResource("LowCeilingShape")
