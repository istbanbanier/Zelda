[gd_scene load_steps=13 format=3]

; Bac à sable de traversal (Phase B). Géométrie de test uniquement.
;
; Les rampes sont des **prismes triangulaires pleins** (ConvexPolygonShape3D), pas
; des boîtes inclinées. La différence n'est pas cosmétique : une boîte tournée
; laisse sous sa face haute un vide dont la face basse forme un surplomb. Le
; premier bac à sable en souffrait — la capsule passait sous la rampe au lieu de
; la gravir, restait au ras du sol et le test de pente échouait sans qu'aucun
; drapeau de collision ne le signale (`is_on_floor()` vrai, `is_on_wall()` faux).
; Un prisme plein n'a pas de dessous : la seule surface accessible est la pente.
;
; Chaque rampe débouche sur un **plateau** assez long pour que le joueur s'y
; arrête. Sans lui, une mesure prise après deux secondes retrouverait le joueur
; retombé au sol derrière la rampe, et le test paraîtrait échouer alors que la
; montée aurait eu lieu.
;
; Pentes encadrant le seuil de §8.2 (~46°) : 40° franchissable, 60° non.
; Base enfoncée de 10 cm sous le sol : la pente émerge sans arête franche.

[sub_resource type="BoxShape3D" id="FloorShape"]
size = Vector3(80, 1, 80)

[sub_resource type="BoxShape3D" id="StepShape"]
size = Vector3(8, 0.32, 8)

; Pente 40° : montée de 4,1955 m sur 5 m de course (z de +3 à -2), puis plateau
; jusqu'à z = -22.
[sub_resource type="ConvexPolygonShape3D" id="RampGentleShape"]
points = PackedVector3Array(-3, -0.1, 3, 3, -0.1, 3, -3, -0.1, -22, 3, -0.1, -22, -3, 4.0955, -2, 3, 4.0955, -2, -3, 4.0955, -22, 3, 4.0955, -22)

; Pente 60° : montée de 5,1962 m sur 3 m de course (z de +3 à 0), puis plateau.
[sub_resource type="ConvexPolygonShape3D" id="RampSteepShape"]
points = PackedVector3Array(-3, -0.1, 3, 3, -0.1, 3, -3, -0.1, -10, 3, -0.1, -10, -3, 5.0962, 0, 3, 5.0962, 0, -3, 5.0962, -10, 3, 5.0962, -10)

[sub_resource type="BoxShape3D" id="WallShape"]
size = Vector3(0.5, 6, 20)

; Parois d'escalade (§9.2, §9.3), alignées en z = -30, écartées les unes des
; autres pour qu'aucun test n'en percute deux.
[sub_resource type="BoxShape3D" id="ClimbWallShape"]
size = Vector3(8, 4, 1)

[sub_resource type="BoxShape3D" id="LowLedgeShape"]
size = Vector3(8, 1.2, 1)

[sub_resource type="BoxShape3D" id="CapShape"]
size = Vector3(8, 0.4, 3)

; Surplomb : paroi flottante dont le bas est hors de portée de la sonde des pieds.
[sub_resource type="BoxShape3D" id="OverhangShape"]
size = Vector3(8, 2.2, 1)

; Marche basse surmontée d'un plafond trop bas pour se hisser (§8.2).
[sub_resource type="BoxShape3D" id="LowStepShape"]
size = Vector3(8, 0.32, 1)

[sub_resource type="BoxShape3D" id="LowCeilingShape"]
size = Vector3(8, 0.2, 2)

[node name="TraversalSandbox" type="Node3D"]

