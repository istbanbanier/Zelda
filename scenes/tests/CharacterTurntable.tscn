[gd_scene load_steps=2 format=3]

; Planche d'INSPECTION d'un personnage (ISS-018) — scène de DEV, exclue de
; l'export final. Un sujet vu de face, de trois quarts, de profil, de dos et
; en aplat noir. Le sujet se choisit par `--creature=<id>` sur la ligne de
; commande ; les identifiants sont les clés de CharacterTurntable.SUBJECTS.
; Tout est construit en code : voir scripts/tools/character_turntable.gd.

[ext_resource type="Script" path="res://scripts/tools/character_turntable.gd" id="1_turntable"]

[node name="CharacterTurntable" type="Node3D"]
script = ExtResource("1_turntable")
