[gd_scene load_steps=4 format=3]

; Citadelle de l'Œil-Tempête — salle 1, initiation (F.2, §15.5). Le décor,
; le circuit et le bloc sont construits par le script : cette scène ne porte
; que la coque, le joueur et l'interface.

[ext_resource type="Script" path="res://scripts/dungeon/room1_initiation.gd" id="1_room"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/GameplayShell.tscn" id="3_shell"]

[node name="Room1Initiation" type="Node3D"]
script = ExtResource("1_room")

[node name="GameplayShell" parent="." instance=ExtResource("3_shell")]
world_scene_path = "res://scenes/dungeon/rooms/Room1Initiation.tscn"

; Le joueur entre par le seuil sud, face au fond (regard -Z) : le couloir de
; poussée, le bloc, le vide entre les plaques et la porte sont dans l'axe.
[node name="Player" parent="." instance=ExtResource("2_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.2, 10.5)

[node name="VisualRoot" parent="Player"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
