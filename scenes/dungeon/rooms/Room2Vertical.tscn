[gd_scene load_steps=4 format=3]

; Citadelle de l'Œil-Tempête — salle 2, circuit vertical (F.3, §15.6). Le
; puits, l'escalade, les électrodes, l'ascenseur et le circuit sont construits
; par le script : cette scène ne porte que la coque, le joueur et l'interface.

[ext_resource type="Script" path="res://scripts/dungeon/room2_vertical.gd" id="1_room"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/GameplayShell.tscn" id="3_shell"]

[node name="Room2Vertical" type="Node3D"]
script = ExtResource("1_room")

[node name="GameplayShell" parent="." instance=ExtResource("3_shell")]
world_scene_path = "res://scenes/dungeon/rooms/Room2Vertical.tscn"

; Le joueur entre par le seuil sud, en bas, face au puits (regard -Z).
[node name="Player" parent="." instance=ExtResource("2_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 0.2, 10)

[node name="VisualRoot" parent="Player"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
