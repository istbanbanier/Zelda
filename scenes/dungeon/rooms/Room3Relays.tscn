[gd_scene load_steps=4 format=3]

; Citadelle de l'Œil-Tempête — salle 3, relais rotatifs (F.4, §15.7). Les
; quatre colonnes, le circuit et le décor sont construits par le script.

[ext_resource type="Script" path="res://scripts/dungeon/room3_relays.gd" id="1_room"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/GameplayShell.tscn" id="3_shell"]

[node name="Room3Relays" type="Node3D"]
script = ExtResource("1_room")

[node name="GameplayShell" parent="." instance=ExtResource("3_shell")]
world_scene_path = "res://scenes/dungeon/rooms/Room3Relays.tscn"

; Le joueur entre par le seuil sud et voit le créneau de câbles devant lui.
[node name="Player" parent="." instance=ExtResource("2_player")]
