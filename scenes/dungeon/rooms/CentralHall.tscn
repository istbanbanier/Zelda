[gd_scene load_steps=4 format=3]

; Citadelle de l'Œil-Tempête — salle centrale (F.6, §15.9). Deux niveaux :
; les trois piliers et les portes des salles au sol, la porte du boss sur la
; galerie nord. Tout est construit par le script.

[ext_resource type="Script" path="res://scripts/dungeon/central_hall.gd" id="1_room"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/GameplayShell.tscn" id="3_shell"]

[node name="CentralHall" type="Node3D"]
script = ExtResource("1_room")

[node name="GameplayShell" parent="." instance=ExtResource("3_shell")]
world_scene_path = "res://scenes/dungeon/rooms/CentralHall.tscn"

; Le joueur entre par le sud : les trois piliers devant lui, la porte du boss
; six mètres plus haut au fond.
[node name="Player" parent="." instance=ExtResource("2_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.2, 12)

[node name="VisualRoot" parent="Player"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
