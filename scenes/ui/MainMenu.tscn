[gd_scene load_steps=4 format=3]

; Menu principal (§17.3). Mise en page par conteneurs, jamais par positions
; absolues : §17.1 l'exige pour que l'interface survive au changement de
; résolution.
;
; LOT 9 : le fond n'est plus un aplat gris — un dégradé crépusculaire (ciel
; d'orage qui s'assombrit vers le sol) + l'emblème « ❖ » en filigrane, dans le
; langage de plaques/or pâle de VISUAL_ASSET_BIBLE §23. Aucune image externe :
; tout est ressource de scène, lisible en diff.

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_menu"]

[sub_resource type="Gradient" id="Gradient_dusk"]
offsets = PackedFloat32Array(0.0, 0.55, 1.0)
colors = PackedColorArray(0.09, 0.13, 0.2, 1, 0.055, 0.07, 0.11, 1, 0.03, 0.04, 0.06, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_dusk"]
gradient = SubResource("Gradient_dusk")
width = 64
height = 512
fill_from = Vector2(0.5, 0)
fill_to = Vector2(0.5, 1)

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.04, 0.06, 1)

[node name="SkyGradient" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = SubResource("GradientTexture2D_dusk")
expand_mode = 1

[node name="Emblem" type="Label" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -160.0
offset_top = -190.0
offset_right = 160.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 260
theme_override_colors/font_color = Color(0.847, 0.702, 0.416, 0.06)
text = "❖"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Layout" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 64
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 64

[node name="Column" type="VBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Layout/Column"]
layout_mode = 2
text = "Éclats d'Orage"
theme_override_font_sizes/font_size = 64
horizontal_alignment = 1

[node name="TitleRule" type="ColorRect" parent="Layout/Column"]
custom_minimum_size = Vector2(320, 1)
layout_mode = 2
size_flags_horizontal = 4
color = Color(0.847, 0.702, 0.416, 0.55)

[node name="Subtitle" type="Label" parent="Layout/Column"]
layout_mode = 2
text = "Vallée de Néris"
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Layout/Column"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="ContinueButton" type="Button" parent="Layout/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
text = "Continuer"

[node name="NewGameButton" type="Button" parent="Layout/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
text = "Nouvelle partie"

[node name="OptionsButton" type="Button" parent="Layout/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
text = "Options"

[node name="TrainingButton" type="Button" parent="Layout/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
text = "Terrain d'entraînement"

[node name="DebugAuditButton" type="Button" parent="Layout/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
text = "Debug — Audit d'entrée"

; « Quitter » ferme la liste — même ordre que le cycle de focus câblé dans
; main_menu.gd : l'œil et la manette parcourent la même séquence.
[node name="QuitButton" type="Button" parent="Layout/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
text = "Quitter"

[node name="StatusLabel" type="Label" parent="Layout/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 32)
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3
