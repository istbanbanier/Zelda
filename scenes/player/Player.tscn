[gd_scene load_steps=12 format=3]

; Joueur — hiérarchie de MASTER_SPEC §6.2, réduite au périmètre de B.3.
; Absents et assumés : StateMachine (§8.1) — le contrôleur porte un Mode couvrant
; exactement les états implémentés, voir D-018 ; Hurtbox et AimOrigin (Phase C) ;
; HeroModel réel (Phase H). Les sondes de §9.2 ne sont pas des nœuds : elles sont
; lancées à la demande par ClimbingComponent, ce qui évite six RayCast3D mis à
; jour à chaque image alors qu'ils ne servent qu'au contact d'une paroi.
; Le corps ne tourne jamais : seul VisualRoot s'oriente, sinon CameraRig
; hériterait de sa rotation.

[ext_resource type="Script" path="res://scripts/player/player_controller.gd" id="1_player"]
[ext_resource type="Script" path="res://scripts/player/camera_rig.gd" id="2_rig"]
[ext_resource type="Script" path="res://scripts/components/player_input_reader.gd" id="3_input"]
[ext_resource type="Resource" path="res://resources/tuning/locomotion_default.tres" id="4_tuning"]
[ext_resource type="Script" path="res://scripts/components/stamina_component.gd" id="5_stamina"]
[ext_resource type="Resource" path="res://resources/tuning/stamina_default.tres" id="6_stamina_tuning"]
[ext_resource type="Script" path="res://scripts/components/climbing_component.gd" id="7_climb"]
[ext_resource type="Script" path="res://scripts/components/ledge_detector_component.gd" id="8_ledge"]
[ext_resource type="Script" path="res://scripts/components/action_alignment_component.gd" id="9_align"]
[ext_resource type="Resource" path="res://resources/tuning/climb_default.tres" id="10_climb_tuning"]

[sub_resource type="CapsuleShape3D" id="Capsule"]
radius = 0.35
height = 1.8

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 1
script = ExtResource("1_player")
tuning = ExtResource("4_tuning")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("Capsule")

[node name="VisualRoot" type="Node3D" parent="."]

[node name="Components" type="Node" parent="."]

[node name="PlayerInputReader" type="Node" parent="Components"]
script = ExtResource("3_input")

[node name="StaminaComponent" type="Node" parent="Components"]
script = ExtResource("5_stamina")
tuning = ExtResource("6_stamina_tuning")

[node name="ClimbingComponent" type="Node" parent="Components"]
script = ExtResource("7_climb")
tuning = ExtResource("10_climb_tuning")

[node name="LedgeDetectorComponent" type="Node" parent="Components"]
script = ExtResource("8_ledge")
tuning = ExtResource("10_climb_tuning")

[node name="ActionAlignmentComponent" type="Node" parent="Components"]
script = ExtResource("9_align")

[node name="CameraRig" type="Node3D" parent="."]
script = ExtResource("2_rig")
tuning = ExtResource("4_tuning")

[node name="YawPivot" type="Node3D" parent="CameraRig"]

[node name="PitchPivot" type="Node3D" parent="CameraRig/YawPivot"]

; Le décalage d'épaule vit ici, sur le bras : SpringArm3D réécrit la position de
; ses enfants directs, un décalage porté par la Camera3D serait effacé.
[node name="SpringArm3D" type="SpringArm3D" parent="CameraRig/YawPivot/PitchPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.32, 0, 0)
collision_mask = 1
spring_length = 4.3

[node name="Camera3D" type="Camera3D" parent="CameraRig/YawPivot/PitchPivot/SpringArm3D"]
fov = 70.0
