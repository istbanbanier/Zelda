[gd_scene load_steps=38 format=3]

; Joueur — hiérarchie de MASTER_SPEC §6.2, réduite au périmètre de B.3.
; Absents et assumés : StateMachine (§8.1) — le contrôleur porte un Mode couvrant
; exactement les états implémentés, voir D-018 ; Hurtbox et AimOrigin (Phase C) ;
; HeroModel réel (Phase H). Les sondes de §9.2 ne sont pas des nœuds : elles sont
; lancées à la demande par ClimbingComponent, ce qui évite six RayCast3D mis à
; jour à chaque image alors qu'ils ne servent qu'au contact d'une paroi.
; Le corps ne tourne jamais : seul VisualRoot s'oriente, sinon CameraRig
; hériterait de sa rotation.

[ext_resource type="Script" path="res://scripts/player/player_controller.gd" id="1_player"]
[ext_resource type="Script" path="res://scripts/player/camera_rig.gd" id="2_rig"]
[ext_resource type="Script" path="res://scripts/components/player_input_reader.gd" id="3_input"]
[ext_resource type="Resource" path="res://resources/tuning/locomotion_default.tres" id="4_tuning"]
[ext_resource type="Script" path="res://scripts/components/stamina_component.gd" id="5_stamina"]
[ext_resource type="Resource" path="res://resources/tuning/stamina_default.tres" id="6_stamina_tuning"]
[ext_resource type="Script" path="res://scripts/components/climbing_component.gd" id="7_climb"]
[ext_resource type="Script" path="res://scripts/components/ledge_detector_component.gd" id="8_ledge"]
[ext_resource type="Script" path="res://scripts/components/action_alignment_component.gd" id="9_align"]
[ext_resource type="Resource" path="res://resources/tuning/climb_default.tres" id="10_climb_tuning"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="11_health"]
[ext_resource type="Script" path="res://scripts/components/hurtbox_component.gd" id="12_hurtbox"]
[ext_resource type="Script" path="res://scripts/components/hitbox_component.gd" id="13_hitbox"]
[ext_resource type="Script" path="res://scripts/combat/attack_controller.gd" id="14_attack"]
[ext_resource type="Resource" path="res://resources/combat/sword/light_1.tres" id="15_light1"]
[ext_resource type="Resource" path="res://resources/combat/sword/light_2.tres" id="16_light2"]
[ext_resource type="Resource" path="res://resources/combat/sword/light_3.tres" id="17_light3"]
[ext_resource type="Script" path="res://scripts/components/lock_on_component.gd" id="18_lock"]
[ext_resource type="Resource" path="res://resources/combat/dodge_default.tres" id="19_dodge"]
[ext_resource type="Resource" path="res://resources/combat/hurt_default.tres" id="20_hurt"]
[ext_resource type="Script" path="res://scripts/combat/bow_component.gd" id="21_bow"]
[ext_resource type="Resource" path="res://resources/combat/bow_default.tres" id="22_bow_tuning"]
[ext_resource type="Resource" path="res://resources/combat/sword/heavy_1.tres" id="23_heavy"]
[ext_resource type="Script" path="res://scripts/components/inventory_component.gd" id="24_inventory"]
[ext_resource type="Resource" path="res://resources/weapons/worn_sword.tres" id="25_worn_sword"]
[ext_resource type="Script" path="res://scripts/characters/character_visual.gd" id="26_visual"]
[ext_resource type="Resource" path="res://resources/characters/hero_anim_set.tres" id="27_animset"]
[ext_resource type="Script" path="res://scripts/player/player_visual_driver.gd" id="28_visdriver"]
[ext_resource type="Script" path="res://scripts/components/status_effect_component.gd" id="29_status"]

[sub_resource type="CapsuleShape3D" id="Capsule"]
radius = 0.35
height = 1.8

; Silhouette graybox : une capsule et un « nez » indiquant le regard. Ce n'est PAS
; un personnage (§7.14 interdit d'appeler « final » un volume gris) — c'est le
; minimum pour que l'opérateur des essais manuels voie où est le corps et où il
; s'oriente. Le HeroModel réel arrive en Phase H.
[sub_resource type="CapsuleMesh" id="GrayboxCapsule"]
radius = 0.35
height = 1.8

[sub_resource type="BoxMesh" id="GrayboxNose"]
size = Vector3(0.14, 0.14, 0.3)

[sub_resource type="StandardMaterial3D" id="GrayboxBody"]
albedo_color = Color(0.55, 0.58, 0.62, 1)

[sub_resource type="StandardMaterial3D" id="GrayboxAccent"]
albedo_color = Color(0.09, 0.56, 0.61, 1)

; Hurtbox du joueur : capsule légèrement plus large que la collision, pour que
; les coups « qui touchent visiblement » touchent (§10.5, fairness).
[sub_resource type="CapsuleShape3D" id="HurtCapsule"]
radius = 0.4
height = 1.8

; Volume de frappe de l'épée : devant le personnage, à hauteur de torse. Enfant
; de VisualRoot : il suit l'orientation du regard, le corps ne tournant jamais.
[sub_resource type="BoxShape3D" id="SwordSweep"]
size = Vector3(1.4, 1.0, 1.1)

; Masque 1|4 : décor + ennemis (PT-D1-02 : les corps ne se traversent plus).
[node name="Player" type="CharacterBody3D" groups=["player", "damageable"]]
collision_layer = 2
collision_mask = 5
script = ExtResource("1_player")
tuning = ExtResource("4_tuning")
dodge = ExtResource("19_dodge")
hurt = ExtResource("20_hurt")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("Capsule")

[node name="VisualRoot" type="Node3D" parent="."]

[node name="BodyMesh" type="MeshInstance3D" parent="VisualRoot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
mesh = SubResource("GrayboxCapsule")
surface_material_override/0 = SubResource("GrayboxBody")

; Le nez pointe vers +Z local : `_orient_visual()` calcule le lacet avec
; atan2(x, z), qui oriente +Z vers le déplacement.
[node name="NoseMesh" type="MeshInstance3D" parent="VisualRoot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.45, 0.38)
mesh = SubResource("GrayboxNose")
surface_material_override/0 = SubResource("GrayboxAccent")

; ART-Q1 : adaptateur du modèle riggé (char.hero via AssetRegistry). S'il
; résout, le graybox se masque (PlayerVisualDriver) ; sinon repli total.
; La capsule de collision et les volumes de combat ne dépendent JAMAIS de lui.
[node name="CharacterVisual" type="Node3D" parent="VisualRoot"]
script = ExtResource("26_visual")
model_id = &"char.hero"
anim_set = ExtResource("27_animset")

; Couche 4 (Player Hitbox), masque 32 (Hurtbox). Sous VisualRoot : le volume de
; frappe suit l'orientation du personnage (+Z local = face, cf. NoseMesh).
[node name="WeaponHitbox" type="Area3D" parent="VisualRoot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.1, 0.85)
collision_layer = 8
collision_mask = 32
script = ExtResource("13_hitbox")
team = &"player"
instigator_path = NodePath("../..")

[node name="CollisionShape3D" type="CollisionShape3D" parent="VisualRoot/WeaponHitbox"]
shape = SubResource("SwordSweep")

; Couche 6 (Hurtbox), masque nul : récepteur pur (§5.7).
[node name="Hurtbox" type="Area3D" parent="." groups=["lock_on_targets"]]
collision_layer = 32
collision_mask = 0
script = ExtResource("12_hurtbox")
team = &"player"
health_path = NodePath("../Components/HealthComponent")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Hurtbox"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("HurtCapsule")

[node name="Components" type="Node" parent="."]

[node name="PlayerInputReader" type="Node" parent="Components"]
script = ExtResource("3_input")

[node name="StaminaComponent" type="Node" parent="Components"]
script = ExtResource("5_stamina")
tuning = ExtResource("6_stamina_tuning")

[node name="ClimbingComponent" type="Node" parent="Components"]
script = ExtResource("7_climb")
tuning = ExtResource("10_climb_tuning")

[node name="LedgeDetectorComponent" type="Node" parent="Components"]
script = ExtResource("8_ledge")
tuning = ExtResource("10_climb_tuning")

[node name="ActionAlignmentComponent" type="Node" parent="Components"]
script = ExtResource("9_align")

[node name="HealthComponent" type="Node" parent="Components"]
script = ExtResource("11_health")
max_health = 100.0

[node name="LockOnComponent" type="Node" parent="Components"]
script = ExtResource("18_lock")

; base_damage = mains nues (D-023) ; l'arme équipée via l'inventaire le remplace.
[node name="AttackController" type="Node" parent="Components"]
script = ExtResource("14_attack")
attacks = [ExtResource("15_light1"), ExtResource("16_light2"), ExtResource("17_light3")]
heavy_attack = ExtResource("23_heavy")
hitbox_path = NodePath("../../VisualRoot/WeaponHitbox")
base_damage = 3.0

; Épée usée de départ (§11.1) et dotation de flèches du bac à sable — le butin
; réel arrive avec les coffres (Phase D).
[node name="InventoryComponent" type="Node" parent="Components"]
script = ExtResource("24_inventory")
default_weapon = ExtResource("25_worn_sword")
starting_arrows = 8

[node name="BowComponent" type="Node3D" parent="Components"]
script = ExtResource("21_bow")
tuning = ExtResource("22_bow_tuning")

; ART-Q1 : traduit mode/vitesse du contrôleur en clips — sens unique, le
; gameplay ne lit RIEN de l'animation.
[node name="PlayerVisualDriver" type="Node" parent="Components"]
script = ExtResource("28_visdriver")

; E.2a (§13.4/§13.5) : UN buff majeur, minuterie pausable ; les
; multiplicateurs se propagent par signal vers hitbox/hurtbox/stamina.
[node name="StatusEffectComponent" type="Node" parent="Components"]
script = ExtResource("29_status")

[node name="CameraRig" type="Node3D" parent="."]
script = ExtResource("2_rig")
tuning = ExtResource("4_tuning")

[node name="YawPivot" type="Node3D" parent="CameraRig"]

[node name="PitchPivot" type="Node3D" parent="CameraRig/YawPivot"]

; Le décalage d'épaule vit ici, sur le bras : SpringArm3D réécrit la position de
; ses enfants directs, un décalage porté par la Camera3D serait effacé.
[node name="SpringArm3D" type="SpringArm3D" parent="CameraRig/YawPivot/PitchPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.32, 0, 0)
collision_mask = 1
spring_length = 4.3

[node name="Camera3D" type="Camera3D" parent="CameraRig/YawPivot/PitchPivot/SpringArm3D"]
fov = 70.0
