{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ensure-hooks.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/qa-stop.sh",
            "timeout": 30,
            "statusMessage": "Garde-fou QA : scan du diff (contenu Nintendo, image de référence, typage, cache d'import)"
          }
        ]
      }
    ]
  }
}
