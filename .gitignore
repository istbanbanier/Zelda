# Godot
.godot/

# ISS-063 — cloison `user://` par arbre de travail (tools/lib/godot_env.sh).
# `user://` ne derive PAS du repertoire de travail mais de
# `application/config/name` : sans XDG_DATA_HOME, tous les arbres ecrivent dans
# le meme ~/.local/share/godot/app_userdata/. Deux runners y ont deja FABRIQUE
# huit echecs de sauvegarde qui n'existaient pas (2026-08-11, tools/CLAUDE.md).
# C'est de l'etat de machine : jamais versionne, jamais dans l'archive jouable
# (tools/make_playable_zip.sh copie une liste explicite qui ne le contient pas).
.godot_user/

# Vidage `--verbose` de la suite complete : ~60 Mo de trace moteur, produit
# pour ENUMERER un residu de fin de processus (ISS-059). Ce qui vaut d'etre
# versionne est sa DECOMPOSITION — quelques dizaines de lignes — pas le vidage.
# Un depot n'est pas un endroit ou stocker ce que personne ne relira.
evidence/**/suite_complete_verbose.log
/android/
*.translation

# Builds et paquets — produits régénérables, jamais versionnés (le build candidat
# est archivé hors dépôt). Les archives déposées à la racine de builds/ en font
# partie : un paquet de validation se reconstruit depuis son commit.
builds/macos/*
builds/windows/*
builds/linux/*
builds/web/*
builds/*.zip
builds/*.tar.gz
builds/*.dmg
# Fragments, empreintes et dossiers d'assemblage produits par
# `tools/make_playable_zip.sh` et par le workflow de publication. L'archive est
# téléversée en GitHub Release, jamais committée : quelques centaines de Mo
# dans l'historique Git seraient irréversibles.
builds/*.sha256
builds/*.zip.*
builds/*.z[0-9][0-9]
builds/*.part
builds/*.partaa
builds/EclatsDOrage_*/
builds/selftest_*/
!builds/*/.gitkeep

# Logs de validation : les preuves retenues sont copiées dans evidence/<gate>/,
# les logs bruts de chaque exécution ne sont pas versionnés.
evidence/validate_fast/
evidence/validate_release/
evidence/pipeline/
evidence/captures/

# Playtest en boîte noire : on versionne la trajectoire, la mémoire du joueur
# et son verdict — la preuve de ce qu'il a fait et compris. Pas le dossier de
# sauvegarde Godot qu'il a généré (une vingtaine de mégaoctets de cache
# d'import par session, sans valeur de preuve), ni le contrôle de plomberie.
evidence/blackbox_player/*/user_home/
evidence/blackbox_player/smoke_*/

# Blender
*.blend1
*.blend2

# Python — caches régénérables des outils de production
__pycache__/
*.py[cod]

# Système
.DS_Store
Thumbs.db
*~
